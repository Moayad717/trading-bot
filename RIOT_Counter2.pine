//@version=6
indicator("RIOT + Counter", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ============================================================================
// MERGE NOTES:
// - Combines the STD-PLAIN primary order-flow entry system with the Counter
//   (fade) entry system into ONE script/state machine, sharing one impulse
//   engine instead of two separate copies.
// - OB and REV order-flow types are DROPPED. Only STD order flows exist.
// - Counter arming is a CONTINUOUS check on every confirmed bar while the
//   STD trade is open (not a one-shot "first bar only" check) — this matches
//   the methodology actually used in the historical $-P&L backtest, so the
//   validated results (win rate, speed, net $ at 10m/15m/30m/2h) apply.
// - Dynamic SL: the STD order flow has NO stop-loss until its Counter fires.
//   The instant the Counter fills (ARMED -> ACTIVE), STD.sl_price is set to
//   Counter.tp_price. If price then reaches that level, the STD flow is
//   marked closed (dynamic-SL) AND a separate "exit_position" alert fires
//   with the same deterministic id, so your execution bot can close the
//   original position. This assumes your bot supports an exit-by-id action —
//   verify that before relying on it; if it doesn't, this alert is inert.
// - If Counter Trade is disabled and the STD box's far end still gets swept,
//   the STD flow is simply marked closed with no SL price (matches the
//   "only if counter is activated" rule literally).
// - Closed STD order flows are removed from tracking entirely (not kept for
//   display) to avoid unbounded memory growth; their drawn objects are
//   explicitly deleted first so nothing is orphaned on the chart.
// - Long and short entries carry separate margin inputs on both the STD leg
//   and the Counter leg, matching the live bot's asymmetric long/short cost
//   structure.
// - TP is re-checked every bar even after a counter has armed/filled — if
//   price recovers to the STD's own TP while a counter is live, the STD
//   closes as TP (not SL) and the counter is closed out too, so nothing sits
//   stuck at "ARMED" forever and no stale dynamic-SL alert fires later.
// ============================================================================

// ============================== 1. INPUTS ==============================
gT = "Trade"
in_std_enable     = input.bool(true, "Enable STD Order Flow", group=gT, tooltip="Controls whether STD entries actually fire the primary alert. Structure tracking (needed for Counter) always runs regardless.")
in_counter_enable = input.bool(true, "Enable Counter Trade", group=gT, tooltip="Controls whether a Counter (fade) position is ever armed/traded when a STD order flow's far end is swept.")
in_roi     = input.float(25.0, "Target ROI %", minval=0.1, step=0.1, group=gT)
in_lev     = input.float(50.0, "Leverage", minval=1.0, step=1.0, group=gT)
in_std_long_margin  = input.float(0.20, "STD Order Flow Margin — Long (USDT)",  step=0.01, group=gT)
in_std_short_margin = input.float(0.13, "STD Order Flow Margin — Short (USDT)", step=0.01, group=gT)
in_ctr_long_margin  = input.float(0.80, "Counter Trade Margin — Long (USDT)",  step=0.01, group=gT)
in_ctr_short_margin = input.float(0.52, "Counter Trade Margin — Short (USDT)", step=0.01, group=gT)

gM = "Rule Mode"
in_mode  = input.string("STD-plain", "Rule mode", options=["STD-plain","STD-ORBK"], group=gM, tooltip="STD-plain = unfiltered STD (recommended: ~9x more signals, same ~99% close quality). STD-ORBK = legacy filtered behavior. The ORBK flag is still recorded/tagged in the alert either way.")
in_debug = input.bool(false, "Debug: mark ALL STD (grey)", group=gM)

gB = "Bot"
in_inst = input.string("LINKUSDT.P", "TV Instrument", group=gB)

gD = "Direction"
in_dir = input.string("Bullish", "Direction", options=["Bullish","Bearish"], group=gD, tooltip="Run one Bullish copy + one Bearish copy.")

gV = "Visual"
in_show_box       = input.bool(true, "Show STD box", group=gV)
in_show_mk        = input.bool(true, "Show STD markers", group=gV)
in_show_tp        = input.bool(true, "Show STD entry/TP/SL lines", group=gV)
in_show_counter        = input.bool(true, "Show Counter boxes", group=gV)
in_show_counter_done    = input.bool(true, "Show completed Counter trades", group=gV)
in_show_table     = input.bool(true, "Show stats table", group=gV)
in_tbl_pos        = input.string("Top Right", "Table position",
     options=["Top Right","Top Left","Top Center","Middle Right","Middle Left",
              "Middle Center","Bottom Right","Bottom Left","Bottom Center"], group=gV)

bool IS_BULL = in_dir == "Bullish"
bool GATED   = in_mode == "STD-ORBK"
string tf_actual = timeframe.period
[tf_open, tf_high, tf_low, tf_close, tf_time] = request.security(syminfo.tickerid, tf_actual, [open, high, low, close, time], lookahead=barmerge.lookahead_off)

// ============================== 2. HELPERS ==============================
get_table_pos(s) =>
    switch s
        "Top Right"     => position.top_right
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Middle Right"  => position.middle_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Bottom Right"  => position.bottom_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        =>                 position.top_right

f_det_id(t, is_long) =>
    str.tostring(t) + (is_long ? "L" : "S")

build_payload(is_long, entry, tp, cur, margin, rule, ofid) =>
    string act = is_long ? "enter_long" : "enter_short"
    float cost = margin * in_lev
    bool deep = is_long ? (cur <= entry) : (cur >= entry)
    string otype = deep ? "market" : "limit"
    string pp = deep ? "" : '"price": "' + str.tostring(entry, "#.#####") + '", '
    '{"id": "' + ofid + '", "interval": "' + tf_actual + '", "trigger_price": "' + str.tostring(cur) + '", "tv_instrument": "' + in_inst + '", "action": "' + act + '", "order": {' + pp + '"amount": "' + str.tostring(cost) + '", "currency_type": "quote", "order_type": "' + otype + '"}, "take_profit": {"enabled": true, "steps": [{"order_type": "limit", "price_percent": ' + str.tostring(is_long ? (in_roi / in_lev) : -(in_roi / in_lev), "#.####") + ', "volume_percent": 100}]}, "rule_type": "' + rule + '"}'

build_exit_payload(ofid, reason, cur) =>
    '{"id": "' + ofid + '", "tv_instrument": "' + in_inst + '", "action": "exit_position", "reason": "' + reason + '", "trigger_price": "' + str.tostring(cur) + '"}'

// Counter entries are always market orders (price already at level).
// Includes close_original block so the bot knows how to set the partial SL
// on the original position when this counter entry fills.
build_counter_payload(is_long, entry, tp, cur, margin, ofid) =>
    string act = is_long ? "enter_long" : "enter_short"
    float cost = margin * in_lev
    '{"id": "' + ofid + '", "interval": "' + tf_actual + '", "trigger_price": "' + str.tostring(cur) + '", "tv_instrument": "' + in_inst + '", "action": "' + act + '", "order": {"amount": "' + str.tostring(cost) + '", "currency_type": "quote", "order_type": "market"}, "take_profit": {"enabled": true, "steps": [{"order_type": "limit", "price_percent": ' + str.tostring(is_long ? (in_roi / in_lev) : -(in_roi / in_lev), "#.####") + ', "volume_percent": 100}]}, "rule_type": "COUNTER", "close_original": {"trigger_price": "' + str.tostring(tp, "#.#####") + '", "mode": "Partial", "order_type": "Market", "place_on": "entry_fill"}}'

tp_of(is_long, e) => is_long ? e * (1 + (in_roi / 100) / in_lev) : e * (1 - (in_roi / 100) / in_lev)

// ============================== 3. TYPES ==============================
type OrderFlow
    bool   is_bull
    bool   is_orbk
    float  box_top
    float  box_bot
    float  entry_price
    float  tp_price
    float  sl_price
    int    conf_bar
    int    conf_time
    bool   entered
    bool   tp_hit
    bool   armed
    bool   sl_hit
    float  counter_entry
    float  counter_tp
    string state          // PENDING, ACTIVE, ARMED, CLOSED
    int    fill_bar
    box    b_ref
    line   en_ref
    line   tp_ref
    line   sl_ref
    label  lbl_ref
    string id

type CounterRecord
    bool   is_long
    float  entry_price
    float  tp_price
    float  box_top
    float  box_bot
    int    entry_time
    int    conf_time
    int    conf_bar
    string state          // ARMED, ACTIVE, INACTIVE
    int    end_time
    box    b_ref
    line   en_ref
    line   tp_ref
    line   orig_en_ref
    line   orig_tp_ref
    label  lbl_ref
    string of_id

// ============================== 4. STATE ==============================
var float last_valid_high = na
var float last_valid_low  = na
var bool  root_init = false
var int   lbv_bar = na
var int   lgv_bar = na
var float lbv_high = na
var float lbv_low  = na
var float lgv_high = na
var float lgv_low  = na
var bool  in_UI = false
var bool  in_LI = false
var int   ui_id = 0
var int   li_id = 0
var int   ui_start = na
var int   li_start = na
var float ui_hh = na
var float ui_ll = na
var float ui_pl = na
var float li_hh = na
var float li_ll = na
var float li_ph = na
var bool  ui_done = false
var bool  li_done = false
var bool  ui_ended_ob = false
var bool  li_ended_ob = false
var float c_ui_hh = na
var float c_ui_ll = na
var int   c_ui_start = na
var float c_li_hh = na
var float c_li_ll = na
var int   c_li_start = na
var float pB_lvl = na
var float pB_boxlow = na
var int   pB_boxbar = na
var float pS_lvl = na
var float pS_boxhigh = na
var int   pS_boxbar = na
var int   pB_uiid = na
var int   pS_liid = na
// ---- ORBK FVG trackers (informational tag only, both modes) ----
var float uf_Chigh = na
var float uf_top = na
var float uf_bot = na
var int   uf_vc = na
var int   uf_form_bar = na
var bool  uf_ready = false
var bool  uf_exists = false
var bool  uf_mitig = false
var float li_Clow = na
var float lf_top = na
var float lf_bot = na
var int   lf_vc = na
var int   lf_form_bar = na
var bool  lf_ready = false
var bool  lf_exists = false
var bool  lf_mitig = false

// ---- unified order-flow / counter tracking ----
var array<OrderFlow>     of_watch = array.new<OrderFlow>()
var array<CounterRecord> counters = array.new<CounterRecord>()
var int MAX_WATCH = 500
var int MAX_CTR   = 500

// ---- persistent stats (survive array trims/removals) ----
var int std_total         = 0
var int std_completed     = 0
var int counter_total     = 0
var int counter_completed = 0
var int n_gate_pass = 0
var int n_gate_fail = 0

var table stat_tbl = na

if not root_init and bar_index == 0
    last_valid_high := tf_high
    last_valid_low  := tf_low
    root_init := true

ui_done := false
li_done := false
ui_ended_ob := false
li_ended_ob := false

// ============================== 5. VALIDITY ==============================
bool bull_v  = tf_high >= last_valid_high
bool bear_v  = tf_low  <= last_valid_low
bool neutral = not bull_v and not bear_v
bool ob = false
if bar_index > 0 and not na(last_valid_high) and not na(last_valid_low)
    ob := (tf_high >= last_valid_high) and (tf_low <= last_valid_low)

// ============================== 6. IMPULSE MANAGEMENT ==============================
if ob
    if in_UI
        c_ui_ll := ui_ll
        c_ui_hh := ui_hh
        c_ui_start := ui_start
        ui_done := true
        ui_ended_ob := true
        ui_id += 1
        in_UI := true
        ui_start := bar_index
        ui_hh := tf_high
        ui_ll := tf_low
        ui_pl := tf_low
        uf_Chigh := tf_high
        uf_vc := 0
        uf_ready := false
        uf_exists := false
        uf_mitig := false
    if in_LI
        c_li_hh := li_hh
        c_li_ll := li_ll
        c_li_start := li_start
        li_done := true
        li_ended_ob := true
        li_id += 1
        in_LI := true
        li_start := bar_index
        li_hh := tf_high
        li_ll := tf_low
        li_ph := tf_high
        li_Clow := tf_low
        lf_vc := 0
        lf_ready := false
        lf_exists := false
        lf_mitig := false

if in_UI and bear_v and not na(ui_pl) and not ob
    if tf_low <= ui_pl
        c_ui_ll := ui_ll
        c_ui_hh := ui_hh
        c_ui_start := ui_start
        ui_done := true
        ui_ended_ob := false
        in_UI := false
        ui_start := na

if bull_v and not ob
    if not in_UI
        ui_id += 1
        in_UI := true
        ui_start := na(lbv_bar) ? bar_index : lbv_bar
        ui_hh := tf_high
        ui_ll := na(lbv_low) ? tf_low : lbv_low
        ui_pl := tf_low
        uf_Chigh := na(lbv_high) ? tf_high : lbv_high
        uf_vc := 0
        uf_ready := false
        uf_exists := false
        uf_mitig := false
    else
        ui_hh := math.max(ui_hh, tf_high)
        ui_ll := math.min(ui_ll, tf_low)
        ui_pl := math.max(ui_pl, tf_low)
if in_UI and neutral
    ui_ll := math.min(ui_ll, tf_low)

if in_LI and bull_v and not na(li_ph) and not ob
    if tf_high >= li_ph
        c_li_hh := li_hh
        c_li_ll := li_ll
        c_li_start := li_start
        li_done := true
        li_ended_ob := false
        in_LI := false
        li_start := na

if bear_v and not ob
    if not in_LI
        li_id += 1
        in_LI := true
        li_start := na(lgv_bar) ? bar_index : lgv_bar
        li_hh := na(lgv_high) ? tf_high : lgv_high
        li_ll := tf_low
        li_ph := tf_high
        li_Clow := na(lgv_low) ? tf_low : lgv_low
        lf_vc := 0
        lf_ready := false
        lf_exists := false
        lf_mitig := false
    else
        li_ll := math.min(li_ll, tf_low)
        li_hh := math.max(li_hh, tf_high)
        li_ph := math.min(li_ph, tf_high)
if in_LI and neutral
    li_hh := math.max(li_hh, tf_high)

// ============================== 7. ORBK FVG (tag only) ==============================
if not neutral and not ob
    if in_UI and not uf_ready and not na(uf_vc)
        uf_vc += 1
        if uf_vc == 2
            uf_ready := true
            if uf_Chigh < tf_low
                uf_exists := true
                uf_bot := uf_Chigh
                uf_top := tf_low
                uf_form_bar := bar_index
    if in_LI and not lf_ready and not na(lf_vc)
        lf_vc += 1
        if lf_vc == 2
            lf_ready := true
            if li_Clow > tf_high
                lf_exists := true
                lf_bot := tf_high
                lf_top := li_Clow
                lf_form_bar := bar_index

if uf_exists and not uf_mitig and not na(uf_form_bar) and bar_index > uf_form_bar and tf_low <= uf_top
    uf_mitig := true
if lf_exists and not lf_mitig and not na(lf_form_bar) and bar_index > lf_form_bar and tf_high >= lf_bot
    lf_mitig := true

// ============================== 8. STD CONFIRM -> CREATE ORDER FLOW ==============================
if barstate.isconfirmed
    if li_done and not na(c_li_hh) and in_UI
        pB_lvl := c_li_hh
        pB_boxlow := c_li_ll
        pB_boxbar := c_li_start
        pB_uiid := ui_id
    if ui_done and not na(c_ui_ll) and in_LI
        pS_lvl := c_ui_ll
        pS_boxhigh := c_ui_hh
        pS_boxbar := c_ui_start
        pS_liid := li_id

    // ---- Bullish STD candidate ----
    if not na(pB_lvl)
        if (not in_UI) or (ui_id != pB_uiid)
            pB_lvl := na
            pB_uiid := na
        else if tf_high >= pB_lvl
            if math.max(tf_open, tf_close) >= pB_lvl
                bool orbk    = uf_exists and not uf_mitig and not li_ended_ob
                bool gate_ok = GATED ? orbk : true
                string rtag  = orbk ? "STD_ORBK" : "STD"
                if in_debug and IS_BULL
                    label.new(bar_index, tf_low, "s", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.gray, 50), textcolor=color.white, size=size.tiny)
                if IS_BULL and gate_ok and array.size(of_watch) < MAX_WATCH
                    n_gate_pass := n_gate_pass + (orbk ? 1 : 0)
                    n_gate_fail := n_gate_fail + (orbk ? 0 : 1)
                    float tp = tp_of(true, pB_lvl)
                    string ofid = f_det_id(tf_time, true)
                    std_total += 1
                    if in_std_enable
                        alert(build_payload(true, pB_lvl, tp, tf_close, in_std_long_margin, rtag, ofid), alert.freq_all)
                    box  bref = na
                    if in_show_box and not na(pB_boxbar)
                        bref := box.new(pB_boxbar, pB_lvl, bar_index, pB_boxlow, border_color=color.new(orbk ? color.teal : #26a69a, 0), border_width=2, bgcolor=color.new(orbk ? color.teal : #26a69a, 80))
                    if in_show_mk
                        label.new(bar_index, tf_low, orbk ? "V" : "v", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(orbk ? color.teal : #26a69a, 0), textcolor=color.white, size=size.small)
                    line enref = na
                    line tpref = na
                    if in_show_tp
                        enref := line.new(bar_index, pB_lvl, bar_index, pB_lvl, color=color.new(#26a69a, 0), width=2)
                        tpref := line.new(bar_index, tp, bar_index, tp, color=color.new(#26a69a, 40), width=1, style=line.style_dashed)
                    array.push(of_watch, OrderFlow.new(is_bull=true, is_orbk=orbk, box_top=pB_lvl, box_bot=pB_boxlow, entry_price=pB_lvl, tp_price=tp, sl_price=na, conf_bar=bar_index, conf_time=tf_time, entered=false, tp_hit=false, armed=false, sl_hit=false, counter_entry=pB_boxlow, counter_tp=tp_of(false, pB_boxlow), state="PENDING", fill_bar=na, b_ref=bref, en_ref=enref, tp_ref=tpref, sl_ref=na, lbl_ref=na, id=ofid))
            pB_lvl := na

    // ---- Bearish STD candidate ----
    if not na(pS_lvl)
        if (not in_LI) or (li_id != pS_liid)
            pS_lvl := na
            pS_liid := na
        else if tf_low <= pS_lvl
            if math.min(tf_open, tf_close) <= pS_lvl
                bool orbk    = lf_exists and not lf_mitig and not ui_ended_ob
                bool gate_ok = GATED ? orbk : true
                string rtag  = orbk ? "STD_ORBK" : "STD"
                if in_debug and not IS_BULL
                    label.new(bar_index, tf_high, "s", yloc=yloc.abovebar, style=label.style_label_down, color=color.new(color.gray, 50), textcolor=color.white, size=size.tiny)
                if (not IS_BULL) and gate_ok and array.size(of_watch) < MAX_WATCH
                    n_gate_pass := n_gate_pass + (orbk ? 1 : 0)
                    n_gate_fail := n_gate_fail + (orbk ? 0 : 1)
                    float tp = tp_of(false, pS_lvl)
                    string ofid = f_det_id(tf_time, false)
                    std_total += 1
                    if in_std_enable
                        alert(build_payload(false, pS_lvl, tp, tf_close, in_std_short_margin, rtag, ofid), alert.freq_all)
                    box  bref = na
                    if in_show_box and not na(pS_boxbar)
                        bref := box.new(pS_boxbar, pS_boxhigh, bar_index, pS_lvl, border_color=color.new(orbk ? color.red : #ef5350, 0), border_width=2, bgcolor=color.new(orbk ? color.red : #ef5350, 80))
                    if in_show_mk
                        label.new(bar_index, tf_high, orbk ? "V" : "v", yloc=yloc.abovebar, style=label.style_label_down, color=color.new(orbk ? color.red : #ef5350, 0), textcolor=color.white, size=size.small)
                    line enref = na
                    line tpref = na
                    if in_show_tp
                        enref := line.new(bar_index, pS_lvl, bar_index, pS_lvl, color=color.new(#ef5350, 0), width=2)
                        tpref := line.new(bar_index, tp, bar_index, tp, color=color.new(#ef5350, 40), width=1, style=line.style_dashed)
                    array.push(of_watch, OrderFlow.new(is_bull=false, is_orbk=orbk, box_top=pS_boxhigh, box_bot=pS_lvl, entry_price=pS_lvl, tp_price=tp, sl_price=na, conf_bar=bar_index, conf_time=tf_time, entered=false, tp_hit=false, armed=false, sl_hit=false, counter_entry=pS_boxhigh, counter_tp=tp_of(true, pS_boxhigh), state="PENDING", fill_bar=na, b_ref=bref, en_ref=enref, tp_ref=tpref, sl_ref=na, lbl_ref=na, id=ofid))
            pS_lvl := na

// ============================== 9. ORDER FLOW LIFECYCLE + COUNTER ARMING ==============================
if barstate.isconfirmed
    while array.size(of_watch) > MAX_WATCH
        old_of = array.get(of_watch, 0)
        if not na(old_of.b_ref)
            box.delete(old_of.b_ref)
        if not na(old_of.en_ref)
            line.delete(old_of.en_ref)
        if not na(old_of.tp_ref)
            line.delete(old_of.tp_ref)
        if not na(old_of.sl_ref)
            line.delete(old_of.sl_ref)
        if not na(old_of.lbl_ref)
            label.delete(old_of.lbl_ref)
        array.shift(of_watch)
    while array.size(counters) > MAX_CTR
        old_c = array.get(counters, 0)
        if not na(old_c.b_ref)
            box.delete(old_c.b_ref)
            line.delete(old_c.en_ref)
            line.delete(old_c.tp_ref)
            line.delete(old_c.orig_en_ref)
            line.delete(old_c.orig_tp_ref)
            label.delete(old_c.lbl_ref)
        array.shift(counters)

    if array.size(of_watch) > 0
        for i = array.size(of_watch) - 1 to 0
            of = array.get(of_watch, i)

            if of.state == "CLOSED"
                // Delete drawn objects BEFORE dropping the record — otherwise
                // the box/lines/label are orphaned on the chart forever
                // (this is the exact bug class hunted down earlier in the
                // Counter Entry script's MAX_WATCH eviction path).
                if not na(of.b_ref)
                    box.delete(of.b_ref)
                if not na(of.en_ref)
                    line.delete(of.en_ref)
                if not na(of.tp_ref)
                    line.delete(of.tp_ref)
                if not na(of.sl_ref)
                    line.delete(of.sl_ref)
                if not na(of.lbl_ref)
                    label.delete(of.lbl_ref)
                array.remove(of_watch, i)
                continue

            if bar_index <= of.conf_bar
                continue

            // fill check
            if not of.entered
                bool touch = of.is_bull ? (tf_low <= of.entry_price) : (tf_high >= of.entry_price)
                if touch
                    of.entered := true
                    of.state := "ACTIVE"
                    of.fill_bar := bar_index

            // TP check — runs every bar regardless of armed state, so a late
            // recovery to the STD's own TP is never missed once a counter has
            // been armed/filled (previously this was pre-arm only, so an
            // armed flow could sit at "ARMED" forever after its own TP hit).
            if of.entered and not of.tp_hit and not of.sl_hit
                bool tp_touch = of.is_bull ? (tf_high >= of.tp_price) : (tf_low <= of.tp_price)
                if tp_touch
                    of.tp_hit := true
                    of.state := "CLOSED"
                    std_completed += 1
                    // If a counter was already live, the original resolved via
                    // its own TP (not via the dynamic SL) — close the counter
                    // out too so nothing is left unmanaged or double-fires later.
                    if of.armed and array.size(counters) > 0
                        for j = array.size(counters) - 1 to 0
                            c = array.get(counters, j)
                            if c.of_id == of.id and (c.state == "ARMED" or c.state == "ACTIVE")
                                bool was_active = c.state == "ACTIVE"
                                c.state := "INACTIVE"
                                c.end_time := tf_time
                                counter_completed += 1
                                if was_active
                                    alert(build_exit_payload(of.id, "STD_TP_COUNTER_STILL_OPEN", tf_close), alert.freq_all)
                                array.set(counters, j, c)
                                break
                    array.set(of_watch, i, of)
                    continue

            // continuous far-end-cleared check -> arm counter (pre-arm only)
            if of.entered and not of.tp_hit and not of.armed and not of.sl_hit
                float body_top = math.max(tf_open, tf_close)
                float body_bot = math.min(tf_open, tf_close)
                bool far_end_cleared = of.is_bull ? (body_bot <= of.box_bot) : (body_top >= of.box_top)
                if far_end_cleared
                    if in_counter_enable and array.size(counters) < MAX_CTR
                        of.armed := true
                        of.state := "ARMED"
                        counter_total += 1
                        array.push(counters, CounterRecord.new(is_long=not of.is_bull, entry_price=of.counter_entry, tp_price=of.counter_tp, box_top=of.box_top, box_bot=of.box_bot, entry_time=tf_time, conf_time=of.conf_time, conf_bar=bar_index, state="ARMED", end_time=na, b_ref=na, en_ref=na, tp_ref=na, orig_en_ref=na, orig_tp_ref=na, lbl_ref=na, of_id=of.id))
                    else
                        of.state := "CLOSED"
                        std_completed += 1
                        array.set(of_watch, i, of)
                        continue

            // sync linked counter + dynamic SL
            if of.armed and not of.sl_hit
                if array.size(counters) > 0
                    for j = array.size(counters) - 1 to 0
                        c = array.get(counters, j)
                        if c.of_id == of.id and (c.state == "ARMED" or c.state == "ACTIVE")
                            if c.state == "ARMED" and bar_index > c.conf_bar
                                bool ctr_touch = c.is_long ? (tf_low <= c.entry_price) : (tf_high >= c.entry_price)
                                if ctr_touch
                                    c.state := "ACTIVE"
                                    of.sl_price := c.tp_price
                                    if in_show_tp
                                        of.sl_ref := line.new(bar_index, of.sl_price, bar_index, of.sl_price, color=color.new(color.orange, 0), width=1, style=line.style_dotted)
                                    if not na(c.entry_price) and not na(c.tp_price)
                                        float ctr_margin = c.is_long ? in_ctr_long_margin : in_ctr_short_margin
                                        alert(build_counter_payload(c.is_long, c.entry_price, c.tp_price, tf_close, ctr_margin, of.id), alert.freq_all)
                            if c.state == "ACTIVE"
                                bool ctr_tp = c.is_long ? (tf_high >= c.tp_price) : (tf_low <= c.tp_price)
                                if ctr_tp
                                    c.state := "INACTIVE"
                                    c.end_time := tf_time
                                    counter_completed += 1
                                    of.sl_hit := true
                                    of.state := "CLOSED"
                                    std_completed += 1
                                    alert(build_exit_payload(of.id, "STD_DYNAMIC_SL", tf_close), alert.freq_all)
                            array.set(counters, j, c)
                            break

            // extend STD visuals
            if not na(of.en_ref)
                line.set_x2(of.en_ref, bar_index)
            if not na(of.tp_ref)
                line.set_x2(of.tp_ref, bar_index)
            if not na(of.sl_ref)
                line.set_x2(of.sl_ref, bar_index)

            array.set(of_watch, i, of)

// ============================== 10. COUNTER VISUALIZATION ==============================
if barstate.isconfirmed and array.size(counters) > 0
    for i = 0 to array.size(counters) - 1
        c = array.get(counters, i)
        bool hide_this = (c.state == "INACTIVE" and not in_show_counter_done) or not in_show_counter
        if hide_this
            if not na(c.b_ref)
                box.delete(c.b_ref)
                line.delete(c.en_ref)
                line.delete(c.tp_ref)
                line.delete(c.orig_en_ref)
                line.delete(c.orig_tp_ref)
                label.delete(c.lbl_ref)
                c.b_ref       := na
                c.en_ref      := na
                c.tp_ref      := na
                c.orig_en_ref := na
                c.orig_tp_ref := na
                c.lbl_ref     := na
                array.set(counters, i, c)
            continue

        color brd_c = c.state == "ACTIVE" ? (c.is_long ? color.new(#00e676,0) : color.new(#ff1744,0)) :
                      c.state == "ARMED"  ? color.new(color.orange, 40) :
                      color.new(color.gray, 50)
        color bg_c  = c.state == "ACTIVE" ? (c.is_long ? color.new(color.green,85) : color.new(color.red,85)) :
                      c.state == "ARMED"  ? (c.is_long ? color.new(color.green,92) : color.new(color.red,92)) :
                      color.new(color.gray, 92)
        int brd_w = c.state == "ACTIVE" ? 3 : 1
        int right_e = c.state == "INACTIVE" ? (not na(c.end_time) ? c.end_time : time) : time

        // Original signal's entry and TP on the opposite side of the box
        float orig_entry     = c.is_long ? c.box_bot : c.box_top
        float orig_tp_price  = tp_of(not c.is_long, orig_entry)
        color orig_e_col     = c.is_long ? color.new(#00e676, 65) : color.new(#ff1744, 65)
        color orig_tp_col    = color.new(color.gray, 40)

        string state_txt = c.state == "ACTIVE" ? "Active" : c.state == "ARMED" ? "Armed" : "Completed"
        string lbl_txt = "[" + tf_actual + "] Counter [" + state_txt + "]\nEntry: " + str.tostring(c.entry_price, "#.#####") + "\nTP: " + str.tostring(c.tp_price, "#.#####") + "\nid: " + c.of_id
        float box_h = c.box_top - c.box_bot
        float lbl_y = c.is_long ? (c.box_bot - box_h * 0.5) : (c.box_top + box_h * 0.5)

        if na(c.b_ref)
            c.b_ref       := box.new(c.entry_time, c.box_top, right_e, c.box_bot, brd_c, brd_w, line.style_solid, xloc=xloc.bar_time, bgcolor=bg_c)
            c.en_ref      := line.new(c.entry_time, c.entry_price, right_e, c.entry_price, color=(c.is_long ? color.new(#00e676,20) : color.new(#ff1744,20)), width=3, style=line.style_solid, xloc=xloc.bar_time)
            c.tp_ref      := line.new(c.entry_time, c.tp_price, right_e, c.tp_price, color=color.new(color.orange, 40), width=1, style=line.style_dashed, xloc=xloc.bar_time)
            c.orig_en_ref := line.new(c.entry_time, orig_entry, right_e, orig_entry, color=orig_e_col, width=2, style=line.style_dashed, xloc=xloc.bar_time)
            c.orig_tp_ref := line.new(c.entry_time, orig_tp_price, right_e, orig_tp_price, color=orig_tp_col, width=1, style=line.style_dashed, xloc=xloc.bar_time)
            c.lbl_ref     := label.new(right_e, lbl_y, text=lbl_txt, style=c.is_long ? label.style_label_up : label.style_label_down, color=brd_c, textcolor=color.white, size=size.small, xloc=xloc.bar_time)
        else
            box.set_right(c.b_ref, right_e)
            box.set_border_color(c.b_ref, brd_c)
            box.set_border_width(c.b_ref, brd_w)
            box.set_bgcolor(c.b_ref, bg_c)
            line.set_x2(c.en_ref, right_e)
            line.set_x2(c.tp_ref, right_e)
            line.set_x2(c.orig_en_ref, right_e)
            line.set_x2(c.orig_tp_ref, right_e)
            label.set_x(c.lbl_ref, right_e)
            label.set_y(c.lbl_ref, lbl_y)
            label.set_text(c.lbl_ref, lbl_txt)
            label.set_color(c.lbl_ref, brd_c)

        array.set(counters, i, c)

// ============================== 11. STRUCTURE UPDATE ==============================
if not neutral
    if bull_v
        last_valid_high := tf_high
        last_valid_low  := tf_low
        lgv_bar := bar_index
        lgv_high := tf_high
        lgv_low  := tf_low
    if bear_v
        last_valid_high := tf_high
        last_valid_low  := tf_low
        lbv_bar := bar_index
        lbv_high := tf_high
        lbv_low  := tf_low

// ============================== 12. STATS TABLE ==============================
if barstate.islast and in_show_table
    int std_pending = 0
    int std_active  = 0
    if array.size(of_watch) > 0
        for i = 0 to array.size(of_watch) - 1
            ofw = array.get(of_watch, i)
            if ofw.state == "PENDING"
                std_pending += 1
            else if ofw.state == "ACTIVE" or ofw.state == "ARMED"
                std_active += 1

    int ctr_pending = 0
    int ctr_active  = 0
    int ctr_done    = 0
    if array.size(counters) > 0
        for i = 0 to array.size(counters) - 1
            cw = array.get(counters, i)
            if cw.state == "ARMED"
                ctr_pending += 1
            else if cw.state == "ACTIVE"
                ctr_active += 1
            else if cw.state == "INACTIVE"
                ctr_done += 1

    table.delete(stat_tbl)
    stat_tbl := table.new(get_table_pos(in_tbl_pos), 5, 5, border_width=1)
    color hb = color.new(#37474f, 20)
    color lb = color.new(#455a64, 80)
    color wt = color.new(color.white, 0)
    color okc = color.new(#66bb6a, 0)
    color pdc = color.new(#ffb74d, 0)
    color dnc = color.new(#42a5f5, 0)

    table.cell(stat_tbl, 0, 0, (GATED ? "STD-ORBK " : "STD-PLAIN ") + (IS_BULL ? "▲" : "▼"), bgcolor=hb, text_color=wt, text_size=size.small)
    table.cell(stat_tbl, 1, 0, "Total", bgcolor=hb, text_color=wt, text_size=size.small)
    table.cell(stat_tbl, 2, 0, "Pend", bgcolor=hb, text_color=wt, text_size=size.small)
    table.cell(stat_tbl, 3, 0, "Active", bgcolor=hb, text_color=wt, text_size=size.small)
    table.cell(stat_tbl, 4, 0, "Done", bgcolor=hb, text_color=wt, text_size=size.small)

    table.cell(stat_tbl, 0, 1, "STD OF", bgcolor=lb, text_color=wt, text_size=size.small)
    table.cell(stat_tbl, 1, 1, str.tostring(std_total), bgcolor=lb, text_color=wt, text_size=size.small)
    table.cell(stat_tbl, 2, 1, str.tostring(std_pending), bgcolor=lb, text_color=pdc, text_size=size.small)
    table.cell(stat_tbl, 3, 1, str.tostring(std_active), bgcolor=lb, text_color=okc, text_size=size.small)
    table.cell(stat_tbl, 4, 1, str.tostring(std_completed), bgcolor=lb, text_color=dnc, text_size=size.small)

    table.cell(stat_tbl, 0, 2, "Counter", bgcolor=lb, text_color=wt, text_size=size.small)
    table.cell(stat_tbl, 1, 2, str.tostring(counter_total), bgcolor=lb, text_color=wt, text_size=size.small)
    table.cell(stat_tbl, 2, 2, str.tostring(ctr_pending), bgcolor=lb, text_color=pdc, text_size=size.small)
    table.cell(stat_tbl, 3, 2, str.tostring(ctr_active), bgcolor=lb, text_color=okc, text_size=size.small)
    table.cell(stat_tbl, 4, 2, str.tostring(counter_completed), bgcolor=lb, text_color=dnc, text_size=size.small)

    table.cell(stat_tbl, 0, 3, "Toggles", bgcolor=hb, text_color=wt, text_size=size.tiny)
    table.cell(stat_tbl, 1, 3, "STD:" + (in_std_enable ? "ON" : "OFF"), bgcolor=hb, text_color=wt, text_size=size.tiny)
    table.cell(stat_tbl, 2, 3, "CTR:" + (in_counter_enable ? "ON" : "OFF"), bgcolor=hb, text_color=wt, text_size=size.tiny)
    table.cell(stat_tbl, 3, 3, "Lev:" + str.tostring(in_lev, "#"), bgcolor=hb, text_color=wt, text_size=size.tiny)
    table.cell(stat_tbl, 4, 3, tf_actual, bgcolor=hb, text_color=wt, text_size=size.tiny)

    table.cell(stat_tbl, 0, 4, "ORBK y/n", bgcolor=lb, text_color=color.new(color.white,20), text_size=size.tiny)
    table.cell(stat_tbl, 1, 4, str.tostring(n_gate_pass), bgcolor=lb, text_color=okc, text_size=size.tiny)
    table.cell(stat_tbl, 2, 4, str.tostring(n_gate_fail), bgcolor=lb, text_color=pdc, text_size=size.tiny)
    table.cell(stat_tbl, 3, 4, "", bgcolor=lb, text_color=wt, text_size=size.tiny)
    table.cell(stat_tbl, 4, 4, "", bgcolor=lb, text_color=wt, text_size=size.tiny)
