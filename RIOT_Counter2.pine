//@version=6
indicator("RIOT AIKO-S STD + Counter — v2", overlay=true,
     max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ============================================================================
// MOTOR STD RECONSTRUIDO desde la especificacion escrita del usuario, mas el
// Counter traido del motor anterior con todas las correcciones acordadas.
//
// LA FRONTERA QUE ORDENA TODO EL DISENO:
//   ANTES de confirmar  -> importa el TIPO de vela (validez, impulsos, cuerpo)
//   DESPUES de confirmar-> importa solo el PRECIO (toca entrada = activa,
//                          toca TP = completa). Que ese movimiento dibuje una
//                          vela valida o invalida es irrelevante.
// El motor anterior mezclaba los dos dominios en tres sitios distintos y de
// ahi salieron sus tres errores.
//
// LA OUTSIDE BAR, TRES VECES NEGATIVA:
//   1. no confirma ningun order flow
//   2. TERMINA el impulso en el que aparece, y esa terminacion CANCELA — no
//      arma candidato
//   3. si otra OB llega antes de que una valida use la primera, la primera
//      queda anulada
//   PERO: un order flow YA CONFIRMADO no se ve afectado. La OB no lo confirmo,
//   asi que no lo puede deshacer. Solo mata candidatos pendientes.
//   Medido sobre 5,729 senales del motor viejo: 175 (3.05%) se confirmaron con
//   una OB. Aqui no ocurre.
//
// POR QUE NO HAY REGLA PARA "VELA INVALIDA QUE TOCA EL NIVEL":
//   Es geometricamente imposible. Mientras el nivel I sigue armado, ninguna
//   valida lo ha superado, luego referencia_alta < nivel_I. Y toda invalida
//   cumple maximo < referencia_alta. Por transitividad su maximo nunca alcanza
//   el nivel. No hace falta la regla y no hay que volver a agregarla.
// ============================================================================

// ============================== 1. INPUTS ==============================
gE = "Engine"
in_lookback = input.int(5000, "Lookback (bars)", minval=100, group=gE,
     tooltip="Rule 1.0: the first candle inside this range is the Root Candle. Its high and low are the first references.")

gT = "Trade"
in_std_enable     = input.bool(true, "Enable STD Order Flow", group=gT)
in_counter_enable = input.bool(true, "Enable Counter Trade", group=gT)
in_roi = input.float(25.0, "Target ROI %", minval=0.1, step=0.1, group=gT)
in_lev = input.float(50.0, "Leverage", minval=1.0, step=1.0, group=gT)
in_std_long_margin  = input.float(1.00, "STD Margin — Long (USDT)",  step=0.01, group=gT)
in_std_short_margin = input.float(0.33, "STD Margin — Short (USDT)", step=0.01, group=gT)
// Named by the ORDER FLOW they hedge, never by the counter's own direction:
// a counter is always the opposite side of its original, so naming them by
// their own direction silently inverts the size ratio.
in_ctr_for_long_margin  = input.float(4.00, "Counter Margin — for LONG order flows (USDT)",  step=0.01, group=gT,
     tooltip="Hedges a LONG order flow, so this counter is itself a SHORT.")
in_ctr_for_short_margin = input.float(1.32, "Counter Margin — for SHORT order flows (USDT)", step=0.01, group=gT,
     tooltip="Hedges a SHORT order flow, so this counter is itself a LONG.")

gB = "Bot"
in_inst = syminfo.ticker  // auto-uses the chart's own symbol — no manual input needed

gD = "Direction"
in_dir = input.string("Bullish", "Direction", options=["Bullish","Bearish"], group=gD,
     tooltip="Run one Bullish copy + one Bearish copy.")

gV = "Visual"
in_show_box   = input.bool(true,  "Show order flow box", group=gV)
in_show_mk    = input.bool(true,  "Show confirmation markers", group=gV)
in_show_lines = input.bool(true,  "Show entry / TP / SL lines", group=gV)
in_show_ctr   = input.bool(true,  "Show Counter", group=gV)
in_show_ctr_unlinked = input.bool(true, "  └ Show chart-only Counters (not sent to bot)", group=gV,
     tooltip="Counters armed from an order flow Pine rebuilt during history replay. No order exists for them on the exchange — drawn greyed out and marked CHART ONLY.")
in_show_valid = input.bool(false, "Mark valid candles (engine check)", group=gV,
     tooltip="Green = bullish valid, red = bearish valid, orange = Outside Bar. Use it to verify the engine against the chart.")
in_show_imp   = input.bool(false, "Show completed impulses", group=gV)
in_show_tbl   = input.bool(true,  "Show stats table", group=gV)
in_tbl_pos    = input.string("Top Right", "Table position",
     options=["Top Right","Top Left","Top Center","Middle Right","Middle Left",
              "Middle Center","Bottom Right","Bottom Left","Bottom Center"], group=gV)

gH = "History"
in_keep_done = input.bool(false, "Keep completed order flows on chart", group=gH,
     tooltip="OFF: a completed flow is dropped and its drawings deleted. ON: kept for review. A flow is never dropped while its counter is still alive.")

bool IS_BULL = in_dir == "Bullish"
string tf_actual = timeframe.period
[tf_open, tf_high, tf_low, tf_close, tf_time] = request.security(
     syminfo.tickerid, tf_actual, [open, high, low, close, time],
     lookahead=barmerge.lookahead_off)

plot(close, title="Scale Anchor", color=color.new(color.white, 100), editable=false)

// ============================== 2. HELPERS ==============================
get_tbl_pos(s) =>
    switch s
        "Top Right"     => position.top_right
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Middle Right"  => position.middle_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Bottom Right"  => position.bottom_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        =>                 position.top_right

// THE TIMEFRAME IS PART OF THE ID. Bar-open time + direction alone is NOT
// unique: two timeframes whose bars open at the same instant produce the same
// id. Confirmed live 2026-08-20 — 1787184000000 is divisible by both 600 and
// 1080, so the 10m and 18m charts emitted the same id and the position opened
// twice on both legs.
f_id(t, tf, is_long) =>
    str.tostring(t) + "_" + tf + "_" + (is_long ? "L" : "S")

// Rule 7
f_tp(is_long, e) =>
    is_long ? e * (1 + (in_roi / 100) / in_lev) : e * (1 - (in_roi / 100) / in_lev)

// "price" is ALWAYS sent, market orders included. The bot derives the TP from
// it (tp_base = price if price is not None else trigger_price), and the TP must
// be anchored to the ORDER FLOW'S LEVEL, never to the confirming candle's
// close. Bybit ignores `price` on market orders, so sending it always is safe.
f_entry_payload(is_long, entry, cur, margin, ofid) =>
    string act  = is_long ? "enter_long" : "enter_short"
    float  cost = margin * in_lev
    bool   deep = is_long ? (cur <= entry) : (cur >= entry)
    string otype = deep ? "market" : "limit"
    '{"id": "' + ofid + '", "interval": "' + tf_actual + '", "trigger_price": "' + str.tostring(cur) + '", "tv_instrument": "' + in_inst + '", "action": "' + act + '", "order": {"price": "' + str.tostring(entry, "#.#####") + '", "amount": "' + str.tostring(cost) + '", "currency_type": "quote", "order_type": "' + otype + '"}, "take_profit": {"enabled": true, "steps": [{"order_type": "limit", "price_percent": ' + str.tostring(is_long ? (in_roi / in_lev) : -(in_roi / in_lev), "#.####") + ', "volume_percent": 100}]}, "rule_type": "STD"}'

// Counter ARM payload — fired the moment the counter confirms, at that candle's
// close. Anything that confirms goes straight to the exchange: the entry limit
// rests on Bybit from here and Bybit fills it at the exact level.
//
// It carries "close_original", the dynamic SL for the ORIGINAL, with two hard
// requirements on the receiving bot:
//
// "place_on": "entry_fill" — the SL is set ONLY when the counter's entry
//   actually fills, together with the counter's own TP, NEVER on receipt of
//   this alert. The entry can rest unfilled (price wicks the level and
//   rejects); setting the SL early would leave the original stopped with no
//   counter to offset it. Counter open <=> SL set, always paired.
//
// "mode": "partial_position_sl" — a PARTIAL position stop, not a reduce-only
//   limit and not a full-position stop.
//     Not a limit: an SL sits on the ACTIVE side of the book, so it is
//     immediately marketable and fills the instant it is placed.
//     Not full-position: on Bybit every same-side flow merges into ONE
//     aggregated position; a full stop would fire the entire book.
f_ctr_payload(is_long, entry, cur, margin, ofid, sl_trigger) =>
    string act  = is_long ? "enter_long" : "enter_short"
    float  cost = margin * in_lev
    bool   deep = is_long ? (cur <= entry) : (cur >= entry)
    string otype = deep ? "market" : "limit"
    '{"id": "' + ofid + '", "interval": "' + tf_actual + '", "trigger_price": "' + str.tostring(cur) + '", "tv_instrument": "' + in_inst + '", "action": "' + act + '", "order": {"price": "' + str.tostring(entry, "#.#####") + '", "amount": "' + str.tostring(cost) + '", "currency_type": "quote", "order_type": "' + otype + '"}, "take_profit": {"enabled": true, "steps": [{"order_type": "limit", "price_percent": ' + str.tostring(is_long ? (in_roi / in_lev) : -(in_roi / in_lev), "#.####") + ', "volume_percent": 100}]}, "rule_type": "COUNTER", "close_original": {"id": "' + ofid + '", "mode": "partial_position_sl", "trigger_price": "' + str.tostring(sl_trigger, "#.#####") + '", "order_type": "market", "place_on": "entry_fill", "reason": "STD_DYNAMIC_SL"}}'

f_cancel_payload(ofid, cur) =>
    '{"id": "' + ofid + '", "tv_instrument": "' + in_inst + '", "action": "cancel_close_original", "reason": "STD_TP_HIT_FIRST", "trigger_price": "' + str.tostring(cur) + '"}'

// ============================== 3. TYPES ==============================
type Flow
    bool   is_long
    float  entry
    float  tp
    float  box_top
    float  box_bot
    int    box_start
    float  ctr_entry        // the FAR end of the box
    float  ctr_tp           // also the SL price on this original
    int    conf_bar
    string state            // UNACTIVE, ACTIVE, COMPLETED
    int    fill_bar
    bool   armed            // its counter has armed
    bool   ctr_live         // its counter is still ARMED or ACTIVE
    float  sl_price
    // TRUE only if this flow's entry alert actually reached the bot, i.e. it
    // confirmed on a REALTIME bar. Flows rebuilt during Pine's history replay
    // have this FALSE — the bot has never heard of them, so nothing carrying
    // their id may be sent to the exchange.
    bool   live
    box    b_ref
    line   en_ref
    line   tp_ref
    line   sl_ref
    string id

type Ctr
    bool   is_long
    float  entry
    float  tp
    int    conf_bar
    string state            // ARMED, ACTIVE, COMPLETED
    int    fill_bar
    // TRUE when the arm alert really went out, i.e. the ORIGINAL was itself
    // alerted live so the bot can resolve the id. FALSE = chart only.
    bool   bot_linked
    line   en_ref
    line   tp_ref
    label  lbl_ref
    string of_id

// ============================== 4. RULE 1 — VALIDITY ==============================
var float ref_high  = na
var float ref_low   = na
var bool  root_done = false

if not root_done and bar_index >= last_bar_index - in_lookback
    ref_high  := tf_high
    ref_low   := tf_low
    root_done := true

// The candle's colour does not matter. Validity is only reaching the reference,
// and reaching it exactly already counts.
bool bull_valid = not na(ref_high) and tf_high >= ref_high
bool bear_valid = not na(ref_low)  and tf_low  <= ref_low
bool is_ob      = bull_valid and bear_valid
bool is_invalid = not bull_valid and not bear_valid

// ============================== 5. RULE 2 — IMPULSES ==============================
// The OB updates BOTH anchors: it is bullish valid and bearish valid at once,
// so it qualifies as "last bullish valid" and as "last bearish valid". Which
// extreme gets used is decided later, by the direction of the next valid
// candle — no decision is needed at the OB itself.
var int   lastBull_bar  = na
var float lastBull_high = na
var int   lastBear_bar  = na
var float lastBear_low  = na

// FOUR values per impulse, each with a different job. Confusing the protective
// level with the impulse extreme moves every entry price on the chart.
var bool  in_UI        = false
var int   ui_start     = na
var float ui_high      = na    // box edge
var float ui_low       = na    // <- THE I LEVEL for a bearish order flow
var float ui_prot      = na    // what kills it
var int   ui_seq       = 0

var bool  in_LI        = false
var int   li_start     = na
var float li_high      = na    // <- THE I LEVEL for a bullish order flow
var float li_low       = na    // box edge
var float li_prot      = na    // what kills it
var int   li_seq       = 0

bool  ui_done   = false
bool  li_done   = false
float done_ui_I = na
float done_ui_top = na
int   done_ui_start = na
float done_li_I = na
float done_li_bot = na
int   done_li_start = na

// Rule 2.7 — an invalid candle has NO structural value. The whole block is
// skipped: it cannot form, extend or kill an impulse, and it does not move the
// references.
if root_done and not is_invalid

    // ---- Rule 2.6 — the Outside Bar CANCELS any live impulse ----
    // It arms nothing. An impulse cancelled by an OB produces no order flow.
    if is_ob
        in_UI := false
        in_LI := false

    // ---- Rule 2.5 — clean death of the Upper Impulse ----
    if not is_ob and in_UI and bear_valid and not na(ui_prot) and tf_low <= ui_prot
        done_ui_I     := ui_low
        done_ui_top   := ui_high
        done_ui_start := ui_start
        ui_done       := true
        in_UI         := false

    // ---- Rule 2.5 — clean death of the Lower Impulse ----
    if not is_ob and in_LI and bull_valid and not na(li_prot) and tf_high >= li_prot
        done_li_I     := li_high
        done_li_bot   := li_low
        done_li_start := li_start
        li_done       := true
        in_LI         := false

    // ---- Rule 2.1 / 2.3 — Upper Impulse ----
    if bull_valid and not is_ob
        if not in_UI
            in_UI    := true
            ui_seq   += 1
            // retroactive start: the last BEARISH valid candle (an OB qualifies)
            ui_start := na(lastBear_bar) ? bar_index : lastBear_bar
            ui_low   := na(lastBear_low) ? tf_low : lastBear_low
            ui_high  := tf_high
            ui_prot  := tf_low
        else
            ui_high := math.max(ui_high, tf_high)
            ui_low  := math.min(ui_low,  tf_low)
            ui_prot := math.max(ui_prot, tf_low)     // only advances with the impulse

    // ---- Rule 2.2 / 2.3 — Lower Impulse ----
    if bear_valid and not is_ob
        if not in_LI
            in_LI    := true
            li_seq   += 1
            li_start := na(lastBull_bar)  ? bar_index : lastBull_bar
            li_high  := na(lastBull_high) ? tf_high : lastBull_high
            li_low   := tf_low
            li_prot  := tf_high
        else
            li_low  := math.min(li_low,  tf_low)
            li_high := math.max(li_high, tf_high)
            li_prot := math.min(li_prot, tf_high)

    // ---- Rule 1.6 — only a valid candle moves the references ----
    ref_high := tf_high
    ref_low  := tf_low
    if bull_valid
        lastBull_bar  := bar_index
        lastBull_high := tf_high
    if bear_valid
        lastBear_bar := bar_index
        lastBear_low := tf_low

// ============================== 6. RULE 4 — DETECTION ==============================
var float pend_bull   = na
var int   pend_bull_seq = na
var float pend_bull_bot = na
var int   pend_bull_start = na
var float pend_bear   = na
var int   pend_bear_seq = na
var float pend_bear_top = na
var int   pend_bear_start = na

// Only a CLEAN impulse death arms a candidate. The OB path never reaches here.
if li_done and in_UI
    pend_bull       := done_li_I
    pend_bull_bot   := done_li_bot
    pend_bull_start := done_li_start
    pend_bull_seq   := ui_seq
if ui_done and in_LI
    pend_bear       := done_ui_I
    pend_bear_top   := done_ui_top
    pend_bear_start := done_ui_start
    pend_bear_seq   := li_seq

var array<Flow> flows = array.new<Flow>()
var array<Ctr>  ctrs  = array.new<Ctr>()
var int MAX_FLOW = 100
var int MAX_CTR  = 80

var int n_total = 0
var int n_done  = 0
var int ctr_total = 0
var int ctr_done  = 0

float new_entry = na
float new_far   = na
int   new_start = na
bool  new_long  = false

if barstate.isconfirmed and root_done

    // ---- Rule 4.3 / 4.4 — bullish confirmation ----
    if not na(pend_bull)
        // Rule 4.5 — the candidate dies with its impulse, clean death or OB
        if not in_UI or ui_seq != pend_bull_seq
            pend_bull := na
        else if not is_invalid and not is_ob and tf_high >= pend_bull
            // The candle has closed. NOW the body decides — not the close.
            if math.max(tf_open, tf_close) >= pend_bull
                new_entry := pend_bull
                new_far   := pend_bull_bot
                new_start := pend_bull_start
                new_long  := true
            // consumed either way: single attempt
            pend_bull := na

    // ---- Rule 4.3 / 4.4 — bearish confirmation ----
    if not na(pend_bear)
        if not in_LI or li_seq != pend_bear_seq
            pend_bear := na
        else if not is_invalid and not is_ob and tf_low <= pend_bear
            if math.min(tf_open, tf_close) <= pend_bear
                new_entry := pend_bear
                new_far   := pend_bear_top
                new_start := pend_bear_start
                new_long  := false
            pend_bear := na

    // ---- create the order flow ----
    if not na(new_entry) and new_long == IS_BULL
        float tp     = f_tp(new_long, new_entry)
        float ctr_tp = f_tp(not new_long, new_far)
        string oid   = f_id(tf_time, tf_actual, new_long)
        n_total += 1
        // alert() is a no-op on historical bars: only a REALTIME confirmation
        // reaches the bot. Record which one this was — it decides whether
        // anything carrying this id may later be sent.
        bool sent = barstate.isrealtime and in_std_enable
        if in_std_enable
            alert(f_entry_payload(new_long, new_entry, tf_close,
                 new_long ? in_std_long_margin : in_std_short_margin, oid), alert.freq_all)
        color col = new_long ? #26a69a : #ef5350
        box  bx = na
        line en = na
        line tl = na
        float b_top = new_long ? new_entry : new_far
        float b_bot = new_long ? new_far   : new_entry
        if in_show_box and not na(new_start)
            bx := box.new(new_start, b_top, bar_index, b_bot,
                 border_color=color.new(col,0), border_width=2, bgcolor=color.new(col,85))
        if in_show_mk
            label.new(bar_index, new_long ? tf_low : tf_high, "v",
                 yloc = new_long ? yloc.belowbar : yloc.abovebar,
                 style = new_long ? label.style_label_up : label.style_label_down,
                 color=color.new(col,0), textcolor=color.white, size=size.small)
        if in_show_lines
            en := line.new(bar_index, new_entry, bar_index, new_entry, color=color.new(col,0), width=2)
            tl := line.new(bar_index, tp, bar_index, tp, color=color.new(col,40), width=1, style=line.style_dashed)
            label.new(bar_index, tp, "TP " + str.tostring(tp, format.mintick),
                 style=label.style_label_left, color=color.new(col,20), textcolor=color.white, size=size.tiny)
        array.push(flows, Flow.new(is_long=new_long, entry=new_entry, tp=tp,
             box_top=b_top, box_bot=b_bot, box_start=new_start,
             ctr_entry=new_far, ctr_tp=ctr_tp, conf_bar=bar_index,
             state="UNACTIVE", fill_bar=na, armed=false, ctr_live=false,
             sl_price=na, live=sent, b_ref=bx, en_ref=en, tp_ref=tl,
             sl_ref=na, id=oid))

// ============================== 7. RULE 5 — FLOW LIFECYCLE ==============================
if barstate.isconfirmed and array.size(flows) > 0

    // Trim. An evicted record stops being managed entirely, so what gets
    // dropped matters: COMPLETED first (pure history), then UNACTIVE (a resting
    // entry that never filled has no path to close itself, so stale ones clog
    // the array), and only then anything else. A live ACTIVE flow is always the
    // last thing dropped. A flow whose counter is still alive is never dropped.
    while array.size(flows) > MAX_FLOW
        int drop = -1
        for k = 0 to array.size(flows) - 1
            fk = array.get(flows, k)
            if fk.state == "COMPLETED" and not fk.ctr_live
                drop := k
                break
        if drop == -1
            for k = 0 to array.size(flows) - 1
                if array.get(flows, k).state == "UNACTIVE"
                    drop := k
                    break
        if drop == -1
            drop := 0
        old = array.get(flows, drop)
        if not na(old.b_ref)
            box.delete(old.b_ref)
        if not na(old.en_ref)
            line.delete(old.en_ref)
        if not na(old.tp_ref)
            line.delete(old.tp_ref)
        if not na(old.sl_ref)
            line.delete(old.sl_ref)
        array.remove(flows, drop)

    for i = array.size(flows) - 1 to 0
        f = array.get(flows, i)

        // A COMPLETED flow whose counter is also done can be dropped.
        if f.state == "COMPLETED" and not f.ctr_live
            if not in_keep_done
                if not na(f.b_ref)
                    box.delete(f.b_ref)
                if not na(f.en_ref)
                    line.delete(f.en_ref)
                if not na(f.tp_ref)
                    line.delete(f.tp_ref)
                if not na(f.sl_ref)
                    line.delete(f.sl_ref)
                array.remove(flows, i)
                continue
            array.set(flows, i, f)
            continue

        if bar_index <= f.conf_bar
            continue

        // ---- Rule 6.2: from here ONLY PRICE MATTERS ----
        // No validity check anywhere below. Candle type is not part of this
        // domain — the movement that touches the entry activates it, the
        // movement that touches the TP completes it.

        // Rule 5.1 — activation (mitigation)
        if f.state == "UNACTIVE"
            bool touch = f.is_long ? (tf_low <= f.entry) : (tf_high >= f.entry)
            if touch
                f.state    := "ACTIVE"
                f.fill_bar := bar_index

        // Rule 5.4 — completion. Strict sequence: the system never looks for
        // completion unless the flow is ACTIVE.
        // Never on the fill bar itself: the entry alert only goes out at that
        // bar's close, so the order does not exist on the exchange until then.
        // The indicator counts short rather than long — the safe direction.
        if f.state == "ACTIVE" and bar_index > f.fill_bar
            bool hit = f.is_long ? (tf_high >= f.tp) : (tf_low <= f.tp)
            if hit
                f.state := "COMPLETED"
                n_done  += 1
                if not na(f.en_ref)
                    line.set_x2(f.en_ref, bar_index)
                if not na(f.tp_ref)
                    line.set_x2(f.tp_ref, bar_index)
                if not na(f.sl_ref)
                    line.set_x2(f.sl_ref, bar_index)
                // The original reached its OWN TP. If a counter already filled,
                // a partial SL is resting on that position — cancel it or it is
                // left orphaned once the position closes.
                if f.armed and array.size(ctrs) > 0
                    for j = array.size(ctrs) - 1 to 0
                        c = array.get(ctrs, j)
                        if c.of_id == f.id and c.state != "COMPLETED"
                            // The counter is NOT touched. It keeps its own
                            // lifecycle — its entry limit is a real live order
                            // on Bybit. Only the SL on the original is orphaned,
                            // and only if the counter actually filled.
                            // A CHART ONLY counter never sent anything, so
                            // there is no SL to cancel.
                            if c.state == "ACTIVE" and c.bot_linked
                                // If this same bar also reached the counter's
                                // TP, the SL fired with it. Intrabar order is
                                // unknowable, so assume it fired.
                                bool same_bar = c.is_long ? (tf_high >= c.tp) : (tf_low <= c.tp)
                                if not same_bar
                                    alert(f_cancel_payload(f.id, tf_close), alert.freq_all)
                            break

        // ---- counter arming ----
        // Arming IS the counter's confirmation, so it belongs to the BEFORE
        // domain: it needs a valid, non-OB candle and the BODY must clear the
        // far end of the box.
        if f.state == "ACTIVE" and not f.armed and not is_invalid and not is_ob
            float body_top = math.max(tf_open, tf_close)
            float body_bot = math.min(tf_open, tf_close)
            bool cleared = f.is_long ? (body_bot <= f.box_bot) : (body_top >= f.box_top)
            if cleared and in_counter_enable
                f.armed    := true
                f.ctr_live := true
                ctr_total  += 1
                // THE REPLAYED-ORIGINAL TRAP. Pine rebuilds this whole state
                // machine from history whenever the script loads or an input
                // changes, and historical bars fire NO alerts. A flow that
                // never reached its TP survives and can have its far end
                // cleared on a REALTIME bar much later — firing an arm alert
                // for an id the bot has never seen. The bot then opens the
                // counter, cannot resolve the original, and leaves it running
                // with no hedge and no stop. That happened live on 8003 on
                // 2026-08-19: a counter armed from a 2026-05-22 order flow.
                // Unlinked counters are still tracked and drawn for study, but
                // NOTHING is sent.
                bool linked = f.live
                array.push(ctrs, Ctr.new(is_long=not f.is_long, entry=f.ctr_entry,
                     tp=f.ctr_tp, conf_bar=bar_index, state="ARMED", fill_bar=na,
                     bot_linked=linked, en_ref=na, tp_ref=na, lbl_ref=na, of_id=f.id))
                if linked
                    float cm = f.is_long ? in_ctr_for_long_margin : in_ctr_for_short_margin
                    alert(f_ctr_payload(not f.is_long, f.ctr_entry, tf_close, cm, f.id, f.ctr_tp), alert.freq_all)

        // ---- THE BOX BELONGS TO THE ORDER FLOW AND KEEPS EXTENDING ----
        // User's rule, verbatim: "se queda alargando si el order flow TP no ha
        // llegado a su destino, igual si el TP del counter no ha llegado al
        // destino despues de activarse entonces tambien se queda alargando".
        // So it extends while EITHER leg is unresolved, and freezes only when
        // both are done. The counter does NOT draw a box of its own — the old
        // engine did, at the counter's own time span but with the original's
        // price levels, which put a rectangle in a price band the market had
        // not traded during that window.
        if not na(f.b_ref)
            box.set_right(f.b_ref, bar_index)
        if not na(f.en_ref)
            line.set_x2(f.en_ref, bar_index)
        if not na(f.tp_ref)
            line.set_x2(f.tp_ref, bar_index)
        if not na(f.sl_ref)
            line.set_x2(f.sl_ref, bar_index)

        array.set(flows, i, f)

// ============================== 8. COUNTER LIFECYCLE ==============================
// The counter's own state machine, deliberately NOT nested inside the flow
// loop. Its entry limit and its TP are real live orders resting on Bybit, so
// they must keep advancing whatever happens to the original — including the
// original completing on its own TP. Nesting this froze 129 of 357 counters in
// ACTIVE on a live chart.
//
// Nothing here fires an alert: both the counter's TP and the original's SL have
// been resting on the exchange since the counter's entry filled, so the real
// closes happen there. This only keeps the chart and the table honest.
if barstate.isconfirmed and array.size(ctrs) > 0

    while array.size(ctrs) > MAX_CTR
        int dc = -1
        for k = 0 to array.size(ctrs) - 1
            if array.get(ctrs, k).state == "COMPLETED"
                dc := k
                break
        if dc == -1
            dc := 0
        oc = array.get(ctrs, dc)
        if not na(oc.en_ref)
            line.delete(oc.en_ref)
        if not na(oc.tp_ref)
            line.delete(oc.tp_ref)
        if not na(oc.lbl_ref)
            label.delete(oc.lbl_ref)
        array.remove(ctrs, dc)

    for j = 0 to array.size(ctrs) - 1
        c = array.get(ctrs, j)
        if c.state == "COMPLETED"
            continue

        // ---- the counter's entry fills — price only, no validity ----
        if c.state == "ARMED" and bar_index > c.conf_bar
            bool touch = c.is_long ? (tf_low <= c.entry) : (tf_high >= c.entry)
            if touch
                c.state    := "ACTIVE"
                c.fill_bar := bar_index
                // mirror the dynamic SL onto the original, if still tracked
                if array.size(flows) > 0
                    for k = 0 to array.size(flows) - 1
                        fs = array.get(flows, k)
                        if fs.id == c.of_id and fs.state != "COMPLETED"
                            fs.sl_price := c.tp
                            if in_show_lines
                                fs.sl_ref := line.new(bar_index, c.tp, bar_index, c.tp,
                                     color=color.new(color.orange,0), width=1, style=line.style_dotted)
                            array.set(flows, k, fs)
                            break

        // ---- the counter reaches its own TP ----
        if c.state == "ACTIVE" and bar_index > c.fill_bar
            bool hit = c.is_long ? (tf_high >= c.tp) : (tf_low <= c.tp)
            if hit
                c.state  := "COMPLETED"
                ctr_done += 1
                // The original is stopped out at this same level — but only if
                // it is still open. It may already have completed on its own TP
                // earlier this same bar, and counting it twice would inflate
                // the table.
                if array.size(flows) > 0
                    for k = 0 to array.size(flows) - 1
                        fc = array.get(flows, k)
                        if fc.id == c.of_id
                            fc.ctr_live := false
                            if fc.state != "COMPLETED"
                                fc.state := "COMPLETED"
                                n_done   += 1
                            array.set(flows, k, fc)
                            break

        array.set(ctrs, j, c)

// ============================== 9. COUNTER VISUALS ==============================
if barstate.isconfirmed and array.size(ctrs) > 0
    for i = 0 to array.size(ctrs) - 1
        c = array.get(ctrs, i)
        bool hide = not in_show_ctr or (not c.bot_linked and not in_show_ctr_unlinked)
        if hide
            if not na(c.en_ref)
                line.delete(c.en_ref)
                c.en_ref := na
            if not na(c.tp_ref)
                line.delete(c.tp_ref)
                c.tp_ref := na
            if not na(c.lbl_ref)
                label.delete(c.lbl_ref)
                c.lbl_ref := na
            array.set(ctrs, i, c)
            continue

        // A CHART ONLY counter is drawn deliberately dull so it can never be
        // mistaken at a glance for a live hedged position.
        color en_col = c.bot_linked ? (c.is_long ? color.new(#00e676,20) : color.new(#ff1744,20)) : color.new(color.gray,35)
        color tp_col = c.bot_linked ? color.new(color.orange,40) : color.new(color.gray,60)
        int   right  = bar_index

        string st = c.state == "ACTIVE" ? "Active" : c.state == "ARMED" ? "Armed" : "Completed"
        float  dpc = ((c.tp / c.entry) - 1) * 100
        string txt = "[" + tf_actual + "] ⚡ Counter " + (c.is_long ? "▲ LONG" : "▼ SHORT") + " [" + st + "]" +
             (c.bot_linked ? "" : "\n⚠ CHART ONLY — original was never sent") +
             "\nEntry: " + str.tostring(c.entry, "#.#####") +
             "\nTP: "    + str.tostring(c.tp, "#.#####") + "  (" + str.tostring(dpc, "#.##") + "%)" +
             (c.bot_linked ? "\nSL on original: " + str.tostring(c.tp, "#.#####") : "") +
             "\nid: " + c.of_id

        if na(c.en_ref)
            c.en_ref := line.new(c.conf_bar, c.entry, right, c.entry, color=en_col, width=3)
            c.tp_ref := line.new(c.conf_bar, c.tp, right, c.tp, color=tp_col, width=1, style=line.style_dashed)
            // Anchored to the counter's OWN entry. The old engine placed it half
            // a box height away from everything it described, which on a wide
            // box left it floating in empty space.
            c.lbl_ref := label.new(right, c.entry, text=txt, style=label.style_label_left,
                 color=en_col, textcolor=color.white, size=size.small)
        else
            line.set_x2(c.en_ref, right)
            line.set_color(c.en_ref, en_col)
            line.set_x2(c.tp_ref, right)
            line.set_color(c.tp_ref, tp_col)
            label.set_x(c.lbl_ref, right)
            label.set_y(c.lbl_ref, c.entry)
            label.set_text(c.lbl_ref, txt)
            label.set_color(c.lbl_ref, en_col)

        array.set(ctrs, i, c)

// ============================== 10. ENGINE CHECK VISUALS ==============================
plotshape(in_show_valid and is_ob, title="Outside Bar", location=location.abovebar,
     style=shape.circle, size=size.tiny, color=color.new(color.orange,0))
plotshape(in_show_valid and bull_valid and not is_ob, title="Bullish valid",
     location=location.belowbar, style=shape.circle, size=size.tiny, color=color.new(#26a69a,0))
plotshape(in_show_valid and bear_valid and not is_ob, title="Bearish valid",
     location=location.abovebar, style=shape.circle, size=size.tiny, color=color.new(#ef5350,0))

if in_show_imp and ui_done and not na(done_ui_start)
    box.new(done_ui_start, done_ui_top, bar_index, done_ui_I,
         border_color=color.new(#ef5350,40), border_width=1, bgcolor=color.new(#ef5350,95))
if in_show_imp and li_done and not na(done_li_start)
    box.new(done_li_start, done_li_I, bar_index, done_li_bot,
         border_color=color.new(#26a69a,40), border_width=1, bgcolor=color.new(#26a69a,95))

// ============================== 11. TABLE ==============================
// Invalidated is tracked implicitly (a discarded candidate simply never becomes
// a flow) and deliberately NOT shown — the user does not want to see it.
var table tbl = na
if barstate.islast and in_show_tbl
    int f_unact = 0
    int f_act   = 0
    if array.size(flows) > 0
        for i = 0 to array.size(flows) - 1
            fw = array.get(flows, i)
            if fw.state == "UNACTIVE"
                f_unact += 1
            else if fw.state == "ACTIVE"
                f_act += 1
    int c_arm = 0
    int c_act = 0
    int c_ghost = 0
    if array.size(ctrs) > 0
        for i = 0 to array.size(ctrs) - 1
            cw = array.get(ctrs, i)
            if cw.state == "ARMED"
                c_arm += 1
            else if cw.state == "ACTIVE"
                c_act += 1
            if not cw.bot_linked
                c_ghost += 1

    table.delete(tbl)
    tbl := table.new(get_tbl_pos(in_tbl_pos), 5, 4, border_width=1)
    color hb = color.new(#37474f,20)
    color lb = color.new(#455a64,80)
    color wt = color.new(color.white,0)
    color ok = color.new(#66bb6a,0)
    color pd = color.new(#ffb74d,0)
    color dn = color.new(#42a5f5,0)

    table.cell(tbl,0,0,"STD " + (IS_BULL ? "▲" : "▼") + " " + tf_actual, bgcolor=hb, text_color=wt, text_size=size.small)
    table.cell(tbl,1,0,"Total",     bgcolor=hb, text_color=wt, text_size=size.small)
    table.cell(tbl,2,0,"Unactive",  bgcolor=hb, text_color=wt, text_size=size.small)
    table.cell(tbl,3,0,"Active",    bgcolor=hb, text_color=wt, text_size=size.small)
    table.cell(tbl,4,0,"Completed", bgcolor=hb, text_color=wt, text_size=size.small)

    table.cell(tbl,0,1,"Order Flow", bgcolor=lb, text_color=wt, text_size=size.small)
    table.cell(tbl,1,1,str.tostring(n_total), bgcolor=lb, text_color=wt, text_size=size.small)
    table.cell(tbl,2,1,str.tostring(f_unact), bgcolor=lb, text_color=pd, text_size=size.small)
    table.cell(tbl,3,1,str.tostring(f_act),   bgcolor=lb, text_color=ok, text_size=size.small)
    table.cell(tbl,4,1,str.tostring(n_done),  bgcolor=lb, text_color=dn, text_size=size.small)

    table.cell(tbl,0,2,"Counter", bgcolor=lb, text_color=wt, text_size=size.small)
    table.cell(tbl,1,2,str.tostring(ctr_total), bgcolor=lb, text_color=wt, text_size=size.small)
    table.cell(tbl,2,2,str.tostring(c_arm),     bgcolor=lb, text_color=pd, text_size=size.small)
    table.cell(tbl,3,2,str.tostring(c_act),     bgcolor=lb, text_color=ok, text_size=size.small)
    table.cell(tbl,4,2,str.tostring(ctr_done),  bgcolor=lb, text_color=dn, text_size=size.small)

    table.cell(tbl,0,3,"Lev:" + str.tostring(in_lev,"#"), bgcolor=hb, text_color=wt, text_size=size.tiny)
    table.cell(tbl,1,3,"STD:" + (in_std_enable ? "ON" : "OFF"), bgcolor=hb, text_color=wt, text_size=size.tiny)
    table.cell(tbl,2,3,"CTR:" + (in_counter_enable ? "ON" : "OFF"), bgcolor=hb, text_color=wt, text_size=size.tiny)
    table.cell(tbl,3,3,"Chart only", bgcolor=hb, text_color=color.new(color.white,25), text_size=size.tiny)
    table.cell(tbl,4,3,str.tostring(c_ghost), bgcolor=hb, text_color=(c_ghost>0 ? color.new(color.gray,0) : wt), text_size=size.tiny)