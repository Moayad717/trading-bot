//@version=6
indicator("RIOT testing", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ============================================================================
// 1. INPUTS
// ============================================================================
grp_trade = "Trade Management"
input_target_roi  = input.float(25.0, "Target ROI %",     minval=0.1, step=0.1, group=grp_trade)
input_leverage    = input.float(50.0, "Leverage",          minval=1.0, step=1.0, group=grp_trade)
input_long_cost   = input.float(0.20, "Long Cost (USDT)",  step=0.01,            group=grp_trade)
input_short_cost  = input.float(0.13, "Short Cost (USDT)", step=0.01,            group=grp_trade)

grp_3c = "3Commas Bot Settings"
input_tv_exchange   = input.string("BYBIT",                  "TV Exchange",   group=grp_3c)
input_tv_instrument = input.string("LINKUSDT.P",             "TV Instrument", group=grp_3c)
input_bot_secret    = input.string("eyJhbGciOiJIUzI1NiJ9.eyJzaWduYWxzX3NvdXJjZV9pZCI6MTg4ODE3fQ.NxqNC7vYJzqNatMBDsjJrJxd65B6sDk2XLOQ_7CxUks", "Bot Secret", group=grp_3c)
input_bot_uuid      = input.string("cca49750-02a7-4c05-a31a-36c5f3397664", "Bot UUID", group=grp_3c)

grp_tf = "Timeframe Settings"
input_tf        = input.timeframe("", "Source Timeframe (empty = chart)", group=grp_tf,
    tooltip="Leave empty for chart timeframe. Set 35, 60, 240, D etc.")
input_color     = input.color(color.blue, "Timeframe Color", group=grp_tf)
input_direction = input.string("Bullish", "Direction", options=["Bullish","Bearish"], group=grp_tf,
    tooltip="Bullish: shows long order flows. Bearish: shows short order flows.")

grp_visual = "Visual Settings"
input_show_impulse_boxes     = input.bool(true,         "Show Impulse Boxes",      group=grp_visual)
input_show_patterns          = input.bool(true,         "Show Pattern Levels",     group=grp_visual)
input_show_inactive_patterns = input.bool(true,         "Show Completed Patterns", group=grp_visual)
input_show_table             = input.bool(true,         "Show Statistics Table",   group=grp_visual)
input_table_pos              = input.string("Top Right", "Table Position",
    options=["Top Right","Top Left","Top Center","Middle Right","Middle Left",
             "Middle Center","Bottom Right","Bottom Left","Bottom Center"],
    group=grp_visual)

// ============================================================================
// 2. CONSTANTS & SCALE ANCHOR
// ============================================================================
bool IS_BULL = input_direction == "Bullish"

plot(close, title="Scale Anchor", color=color.new(color.white, 100), editable=false)

string tf_actual = input_tf == "" ? timeframe.period : input_tf
var int last_processed_tf_time = -1

[tf_open, tf_high, tf_low, tf_close, tf_time] = request.security(
    syminfo.tickerid, tf_actual,
    [open, high, low, close, time],
    lookahead=barmerge.lookahead_off)

// ============================================================================
// 3. HELPER FUNCTIONS
// ============================================================================
build_payload(is_long, entry_price, tp_price, current_close, ptype) =>
    string action = is_long ? "enter_long" : "enter_short"
    // Send full position value (cost × leverage) not margin cost.
    // 3Commas treats 'amount' as position value in USDT, not as margin.
    float  cost      = is_long ? (input_long_cost * input_leverage) : (input_short_cost * input_leverage)
    bool   is_deep   = is_long ? (current_close <= entry_price) : (current_close >= entry_price)
    string order_type  = is_deep ? "market" : "limit"
    string price_param = is_deep ? "" : '"price": "' + str.tostring(entry_price, "#.#####") + '", '
    '{"secret": "' + input_bot_secret + '", "max_lag": "300", "timestamp": "' + str.tostring(timenow) + '", "trigger_price": "' + str.tostring(current_close) + '", "tv_exchange": "' + input_tv_exchange + '", "tv_instrument": "' + input_tv_instrument + '", "action": "' + action + '", "bot_uuid": "' + input_bot_uuid + '", "order": {' + price_param + '"amount": "' + str.tostring(cost) + '", "currency_type": "quote", "order_type": "' + order_type + '"}, "take_profit": {"enabled": true, "steps": [{"order_type": "limit", "price_percent": ' + str.tostring(is_long ? (input_target_roi / input_leverage) : -(input_target_roi / input_leverage), "#.####") + ', "volume_percent": 100}]}, "pattern": "' + ptype + '"}'

calculate_dynamic_tp(is_long, entry_price) =>
    float tp = is_long ? entry_price * (1 + (input_target_roi / 100) / input_leverage)
                       : entry_price * (1 - (input_target_roi / 100) / input_leverage)
    tp

get_rule_label(ptype) =>
    switch ptype
        "BULL_STD" => "Rule 2.1 (Impulse Pullback)"
        "BEAR_STD" => "Rule 2.2 (Impulse Pullback)"
        "BULL_OB"  => "Rule 4.2 (Bullish OB)"
        "BEAR_OB"  => "Rule 4.4 (Bearish OB)"
        "BULL_REV" => "Rule 4.5 (Bullish Rev)"
        "BEAR_REV" => "Rule 4.3 (Bearish Rev)"
        =>            ""

get_table_pos(s) =>
    switch s
        "Top Right"     => position.top_right
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Middle Right"  => position.middle_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Bottom Right"  => position.bottom_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        =>                 position.top_right

// ============================================================================
// 4. TYPE DEFINITIONS
// ============================================================================
type Pattern
    string pattern_type
    int    id
    float  entry_price
    float  tp_price
    int    entry_bar
    int    confirmation_bar
    int    entry_time
    int    confirmation_time
    string state
    bool   first_touch_occurred
    int    fill_bar
    string hosting_impulse
    float  box_high
    float  box_low
    int    end_time

type ImpulseRecord
    string impulse_type
    int    start_bar
    int    end_bar
    int    start_time
    int    end_time
    float  highest_high
    float  lowest_low

// ============================================================================
// 5. GLOBAL VARIABLES
// ============================================================================
var float last_valid_high = na
var float last_valid_low  = na
var bool  root_initialized = false

var int   last_bullish_valid_bar  = na
var int   last_bullish_valid_time = na
var int   last_bearish_valid_bar  = na
var int   last_bearish_valid_time = na
var float last_bullish_valid_high = na
var float last_bullish_valid_low  = na
var float last_bearish_valid_high = na
var float last_bearish_valid_low  = na

var bool  in_upper_impulse        = false
var int   ui_id                   = 0
var int   impulse_start_bar       = na
var int   impulse_start_time      = na
var float impulse_highest_high    = na
var float impulse_lowest_low      = na
var float impulse_protective_low  = na

var bool  in_lower_impulse              = false
var int   li_id                         = 0
var int   lower_impulse_start_bar       = na
var int   lower_impulse_start_time      = na
var float lower_impulse_highest_high    = na
var float lower_impulse_lowest_low      = na
var float lower_impulse_protective_high = na

var array<Pattern>       patterns            = array.new<Pattern>()
var int                  pattern_counter     = 0
int                      MAX_PATTERNS_STORED = 350
var array<ImpulseRecord> impulse_history     = array.new<ImpulseRecord>()

var bool  ui_just_completed = false
var bool  li_just_completed = false

var float completed_ui_lowest_low   = na
var float completed_ui_highest_high = na
var int   completed_ui_start_bar    = na
var int   completed_ui_start_time   = na

var float completed_li_highest_high = na
var float completed_li_lowest_low   = na
var int   completed_li_start_bar    = na
var int   completed_li_start_time   = na

var float pending_bull_std_level      = na
var int   pending_bull_std_entry_bar  = na
var int   pending_bull_std_entry_time = na
var float pending_bull_std_box_high   = na
var float pending_bull_std_box_low    = na
var int   pending_bull_std_ui_id      = na

var float pending_bear_std_level      = na
var int   pending_bear_std_entry_bar  = na
var int   pending_bear_std_entry_time = na
var float pending_bear_std_box_high   = na
var float pending_bear_std_box_low    = na
var int   pending_bear_std_li_id      = na

var float pending_bear_rev_level      = na
var int   pending_bear_rev_bar        = na
var int   pending_bear_rev_time       = na
var float pending_bear_rev_box_high   = na
var float pending_bear_rev_box_low    = na
var bool  pending_bear_rev_first_seen = false

var float pending_bull_rev_level      = na
var int   pending_bull_rev_bar        = na
var int   pending_bull_rev_time       = na
var float pending_bull_rev_box_high   = na
var float pending_bull_rev_box_low    = na
var bool  pending_bull_rev_first_seen = false

// ============================================================================
// 6. INITIALIZATION & TRANSIENT SNAPSHOTS
// ============================================================================
if not root_initialized and bar_index == 0
    last_valid_high  := tf_high
    last_valid_low   := tf_low
    root_initialized := true

if barstate.isconfirmed
    while array.size(patterns) > MAX_PATTERNS_STORED
        array.shift(patterns)

float prev_last_bullish_valid_high = last_bullish_valid_high
float prev_last_bearish_valid_low  = last_bearish_valid_low

ui_just_completed := false
li_just_completed := false

// ============================================================================
// 7. VALIDITY & OUTSIDE BAR CHECK
// ============================================================================
bool is_bullish_valid = tf_high >= last_valid_high
bool is_bearish_valid = tf_low  <= last_valid_low
bool is_neutral       = not is_bullish_valid and not is_bearish_valid

bool is_outside_bar = false
if bar_index > 0 and not na(last_valid_high) and not na(last_valid_low)
    is_outside_bar := (tf_high >= last_valid_high) and (tf_low <= last_valid_low)

// ============================================================================
// 8. IMPULSE MANAGEMENT
// ============================================================================
if is_outside_bar
    if in_upper_impulse
        array.push(impulse_history, ImpulseRecord.new("UI", impulse_start_bar, bar_index - 1, impulse_start_time, tf_time[1], impulse_highest_high, impulse_lowest_low))
        completed_ui_lowest_low   := impulse_lowest_low
        completed_ui_highest_high := impulse_highest_high
        completed_ui_start_bar    := impulse_start_bar
        completed_ui_start_time   := impulse_start_time
        ui_just_completed         := true
        ui_id += 1
        in_upper_impulse       := true
        impulse_start_bar      := bar_index
        impulse_start_time     := tf_time
        impulse_highest_high   := tf_high
        impulse_lowest_low     := tf_low
        impulse_protective_low := tf_low

    if in_lower_impulse
        array.push(impulse_history, ImpulseRecord.new("LI", lower_impulse_start_bar, bar_index - 1, lower_impulse_start_time, tf_time[1], lower_impulse_highest_high, lower_impulse_lowest_low))
        completed_li_highest_high     := lower_impulse_highest_high
        completed_li_lowest_low       := lower_impulse_lowest_low
        completed_li_start_bar        := lower_impulse_start_bar
        completed_li_start_time       := lower_impulse_start_time
        li_just_completed             := true
        li_id += 1
        in_lower_impulse              := true
        lower_impulse_start_bar       := bar_index
        lower_impulse_start_time      := tf_time
        lower_impulse_highest_high    := tf_high
        lower_impulse_lowest_low      := tf_low
        lower_impulse_protective_high := tf_high

if in_upper_impulse and is_bearish_valid and not na(impulse_protective_low) and not is_outside_bar
    if tf_low <= impulse_protective_low or tf_close < impulse_protective_low
        array.push(impulse_history, ImpulseRecord.new("UI", impulse_start_bar, bar_index - 1, impulse_start_time, tf_time[1], impulse_highest_high, impulse_lowest_low))
        completed_ui_lowest_low   := impulse_lowest_low
        completed_ui_highest_high := impulse_highest_high
        completed_ui_start_bar    := impulse_start_bar
        completed_ui_start_time   := impulse_start_time
        ui_just_completed         := true
        in_upper_impulse          := false
        impulse_start_bar         := na

if is_bullish_valid and not is_outside_bar
    if not in_upper_impulse
        ui_id += 1
        in_upper_impulse       := true
        impulse_start_bar      := na(last_bearish_valid_bar)  ? bar_index : last_bearish_valid_bar
        impulse_start_time     := na(last_bearish_valid_time) ? tf_time   : last_bearish_valid_time
        impulse_highest_high   := tf_high
        impulse_lowest_low     := na(last_bearish_valid_low)  ? tf_low    : last_bearish_valid_low
        impulse_protective_low := tf_low
    else
        if tf_high > impulse_highest_high
            impulse_highest_high := tf_high
        if tf_low < impulse_lowest_low
            impulse_lowest_low := tf_low
        if tf_low > impulse_protective_low
            impulse_protective_low := tf_low

if in_upper_impulse and is_neutral
    if tf_low < impulse_lowest_low
        impulse_lowest_low := tf_low

if in_lower_impulse and is_bullish_valid and not na(lower_impulse_protective_high) and not is_outside_bar
    if tf_high >= lower_impulse_protective_high or tf_close > lower_impulse_protective_high
        array.push(impulse_history, ImpulseRecord.new("LI", lower_impulse_start_bar, bar_index - 1, lower_impulse_start_time, tf_time[1], lower_impulse_highest_high, lower_impulse_lowest_low))
        completed_li_highest_high := lower_impulse_highest_high
        completed_li_lowest_low   := lower_impulse_lowest_low
        completed_li_start_bar    := lower_impulse_start_bar
        completed_li_start_time   := lower_impulse_start_time
        li_just_completed         := true
        in_lower_impulse          := false
        lower_impulse_start_bar   := na

if is_bearish_valid and not is_outside_bar
    if not in_lower_impulse
        li_id += 1
        in_lower_impulse              := true
        lower_impulse_start_bar       := na(last_bullish_valid_bar)  ? bar_index : last_bullish_valid_bar
        lower_impulse_start_time      := na(last_bullish_valid_time) ? tf_time   : last_bullish_valid_time
        lower_impulse_highest_high    := na(last_bullish_valid_high) ? tf_high   : last_bullish_valid_high
        lower_impulse_lowest_low      := tf_low
        lower_impulse_protective_high := tf_high
    else
        if tf_low < lower_impulse_lowest_low
            lower_impulse_lowest_low := tf_low
        if tf_high > lower_impulse_highest_high
            lower_impulse_highest_high := tf_high
        if tf_high < lower_impulse_protective_high
            lower_impulse_protective_high := tf_high

if in_lower_impulse and is_neutral
    if tf_high > lower_impulse_highest_high
        lower_impulse_highest_high := tf_high

// ============================================================================
// 9. PATTERN ARMING & CONFIRMATION (confirmed bars only)
// ============================================================================
if barstate.isconfirmed

    if li_just_completed and not na(completed_li_highest_high) and in_upper_impulse
        pending_bull_std_level      := completed_li_highest_high
        pending_bull_std_entry_bar  := completed_li_start_bar
        pending_bull_std_entry_time := completed_li_start_time
        pending_bull_std_box_high   := completed_li_highest_high
        pending_bull_std_box_low    := completed_li_lowest_low
        pending_bull_std_ui_id      := ui_id

    if ui_just_completed and not na(completed_ui_lowest_low) and in_lower_impulse
        pending_bear_std_level      := completed_ui_lowest_low
        pending_bear_std_entry_bar  := completed_ui_start_bar
        pending_bear_std_entry_time := completed_ui_start_time
        pending_bear_std_box_high   := completed_ui_highest_high
        pending_bear_std_box_low    := completed_ui_lowest_low
        pending_bear_std_li_id      := li_id

    if is_outside_bar
        float ob_body_top = math.max(tf_open, tf_close)
        float ob_body_bot = math.min(tf_open, tf_close)

        if in_upper_impulse
            // Rule 4.2 — Bullish OB
            if not na(prev_last_bullish_valid_high)
                if ob_body_top >= prev_last_bullish_valid_high
                    pattern_counter += 1
                    float tp_calc     = calculate_dynamic_tp(true, prev_last_bullish_valid_high)
                    bool  is_deep     = tf_close <= prev_last_bullish_valid_high
                    string init_state = is_deep ? "ACTIVE" : "UNACTIVE"
                    int    fill_b     = is_deep ? bar_index : na
                    array.push(patterns, Pattern.new("BULL_OB", pattern_counter, prev_last_bullish_valid_high, tp_calc, last_bullish_valid_bar, bar_index, last_bullish_valid_time, tf_time, init_state, true, fill_b, "UI", prev_last_bullish_valid_high, tf_low, na))
                    if IS_BULL
                        alert(build_payload(true, prev_last_bullish_valid_high, tp_calc, tf_close, "BULL_OB"), alert.freq_all)

            // Rule 2.2 — Bear STD via OB
            if not na(completed_ui_lowest_low) and ob_body_bot <= completed_ui_lowest_low
                pattern_counter += 1
                float tp_calc     = calculate_dynamic_tp(false, completed_ui_lowest_low)
                bool  is_deep     = tf_close >= completed_ui_lowest_low
                string init_state = is_deep ? "ACTIVE" : "UNACTIVE"
                int    fill_b     = is_deep ? bar_index : na
                array.push(patterns, Pattern.new("BEAR_STD", pattern_counter, completed_ui_lowest_low, tp_calc, completed_ui_start_bar, bar_index, completed_ui_start_time, tf_time, init_state, true, fill_b, "UI", completed_ui_highest_high, completed_ui_lowest_low, na))
                if not IS_BULL
                    alert(build_payload(false, completed_ui_lowest_low, tp_calc, tf_close, "BEAR_STD"), alert.freq_all)

            pending_bear_rev_level      := tf_low
            pending_bear_rev_bar        := bar_index
            pending_bear_rev_time       := tf_time
            pending_bear_rev_box_high   := tf_high
            pending_bear_rev_box_low    := tf_low
            pending_bear_rev_first_seen := false
            pending_bull_rev_level      := na
            pending_bull_rev_first_seen := false

        if in_lower_impulse
            // Rule 4.4 — Bearish OB
            if not na(prev_last_bearish_valid_low)
                if ob_body_bot <= prev_last_bearish_valid_low
                    pattern_counter += 1
                    float tp_calc     = calculate_dynamic_tp(false, prev_last_bearish_valid_low)
                    bool  is_deep     = tf_close >= prev_last_bearish_valid_low
                    string init_state = is_deep ? "ACTIVE" : "UNACTIVE"
                    int    fill_b     = is_deep ? bar_index : na
                    array.push(patterns, Pattern.new("BEAR_OB", pattern_counter, prev_last_bearish_valid_low, tp_calc, last_bearish_valid_bar, bar_index, last_bearish_valid_time, tf_time, init_state, true, fill_b, "LI", tf_high, prev_last_bearish_valid_low, na))
                    if not IS_BULL
                        alert(build_payload(false, prev_last_bearish_valid_low, tp_calc, tf_close, "BEAR_OB"), alert.freq_all)

            // Rule 2.1 — Bull STD via OB
            if not na(completed_li_highest_high) and ob_body_top >= completed_li_highest_high
                pattern_counter += 1
                float tp_calc     = calculate_dynamic_tp(true, completed_li_highest_high)
                bool  is_deep     = tf_close <= completed_li_highest_high
                string init_state = is_deep ? "ACTIVE" : "UNACTIVE"
                int    fill_b     = is_deep ? bar_index : na
                array.push(patterns, Pattern.new("BULL_STD", pattern_counter, completed_li_highest_high, tp_calc, completed_li_start_bar, bar_index, completed_li_start_time, tf_time, init_state, true, fill_b, "LI", completed_li_highest_high, completed_li_lowest_low, na))
                if IS_BULL
                    alert(build_payload(true, completed_li_highest_high, tp_calc, tf_close, "BULL_STD"), alert.freq_all)

            pending_bull_rev_level      := tf_high
            pending_bull_rev_bar        := bar_index
            pending_bull_rev_time       := tf_time
            pending_bull_rev_box_high   := tf_high
            pending_bull_rev_box_low    := tf_low
            pending_bull_rev_first_seen := false
            pending_bear_rev_level      := na
            pending_bear_rev_first_seen := false

    // Rule 2.1 — Bull STD confirmation
    if not na(pending_bull_std_level)
        if (not in_upper_impulse) or (ui_id != pending_bull_std_ui_id)
            pending_bull_std_level := na
            pending_bull_std_ui_id := na
        else
            if tf_high >= pending_bull_std_level
                if tf_close >= pending_bull_std_level
                    pattern_counter += 1
                    float tp_calc     = calculate_dynamic_tp(true, pending_bull_std_level)
                    bool  is_deep     = tf_close <= pending_bull_std_level
                    string init_state = is_deep ? "ACTIVE" : "UNACTIVE"
                    int    fill_b     = is_deep ? bar_index : na
                    array.push(patterns, Pattern.new("BULL_STD", pattern_counter, pending_bull_std_level, tp_calc, pending_bull_std_entry_bar, bar_index, pending_bull_std_entry_time, tf_time, init_state, true, fill_b, "UI", pending_bull_std_box_high, pending_bull_std_box_low, na))
                    if IS_BULL
                        alert(build_payload(true, pending_bull_std_level, tp_calc, tf_close, "BULL_STD"), alert.freq_all)
                pending_bull_std_level := na

    // Rule 2.2 — Bear STD confirmation
    if not na(pending_bear_std_level)
        if (not in_lower_impulse) or (li_id != pending_bear_std_li_id)
            pending_bear_std_level := na
            pending_bear_std_li_id := na
        else
            if tf_low <= pending_bear_std_level
                if tf_close <= pending_bear_std_level
                    pattern_counter += 1
                    float tp_calc     = calculate_dynamic_tp(false, pending_bear_std_level)
                    bool  is_deep     = tf_close >= pending_bear_std_level
                    string init_state = is_deep ? "ACTIVE" : "UNACTIVE"
                    int    fill_b     = is_deep ? bar_index : na
                    array.push(patterns, Pattern.new("BEAR_STD", pattern_counter, pending_bear_std_level, tp_calc, pending_bear_std_entry_bar, bar_index, pending_bear_std_entry_time, tf_time, init_state, true, fill_b, "LI", pending_bear_std_box_high, pending_bear_std_box_low, na))
                    if not IS_BULL
                        alert(build_payload(false, pending_bear_std_level, tp_calc, tf_close, "BEAR_STD"), alert.freq_all)
                pending_bear_std_level := na

    // Rule 4.3 — Bear REV (first valid candle only)
    if not na(pending_bear_rev_level) and bar_index > pending_bear_rev_bar
        if is_bullish_valid and tf_high > pending_bear_rev_box_high
            pending_bear_rev_level      := na
            pending_bear_rev_first_seen := false
        else if not is_neutral
            if not pending_bear_rev_first_seen
                pending_bear_rev_first_seen := true
                float body_bot = math.min(tf_open, tf_close)
                if body_bot <= pending_bear_rev_level
                    pattern_counter += 1
                    float tp_calc     = calculate_dynamic_tp(false, pending_bear_rev_level)
                    bool  is_deep     = tf_close >= pending_bear_rev_level
                    string init_state = is_deep ? "ACTIVE" : "UNACTIVE"
                    int    fill_b     = is_deep ? bar_index : na
                    array.push(patterns, Pattern.new("BEAR_REV", pattern_counter, pending_bear_rev_level, tp_calc, pending_bear_rev_bar, bar_index, pending_bear_rev_time, tf_time, init_state, true, fill_b, "OB", pending_bear_rev_box_high, pending_bear_rev_box_low, na))
                    if not IS_BULL
                        alert(build_payload(false, pending_bear_rev_level, tp_calc, tf_close, "BEAR_REV"), alert.freq_all)
                pending_bear_rev_level      := na
                pending_bear_rev_first_seen := false

    // Rule 4.5 — Bull REV (first valid candle only)
    if not na(pending_bull_rev_level) and bar_index > pending_bull_rev_bar
        if is_bearish_valid and tf_low < pending_bull_rev_box_low
            pending_bull_rev_level      := na
            pending_bull_rev_first_seen := false
        else if not is_neutral
            if not pending_bull_rev_first_seen
                pending_bull_rev_first_seen := true
                float body_top = math.max(tf_open, tf_close)
                if body_top >= pending_bull_rev_level
                    pattern_counter += 1
                    float tp_calc     = calculate_dynamic_tp(true, pending_bull_rev_level)
                    bool  is_deep     = tf_close <= pending_bull_rev_level
                    string init_state = is_deep ? "ACTIVE" : "UNACTIVE"
                    int    fill_b     = is_deep ? bar_index : na
                    array.push(patterns, Pattern.new("BULL_REV", pattern_counter, pending_bull_rev_level, tp_calc, pending_bull_rev_bar, bar_index, pending_bull_rev_time, tf_time, init_state, true, fill_b, "OB", pending_bull_rev_box_high, pending_bull_rev_box_low, na))
                    if IS_BULL
                        alert(build_payload(true, pending_bull_rev_level, tp_calc, tf_close, "BULL_REV"), alert.freq_all)
                pending_bull_rev_level      := na
                pending_bull_rev_first_seen := false

// ============================================================================
// 10. FINAL STRUCTURE UPDATE
// ============================================================================
if not is_neutral
    if is_bullish_valid
        last_valid_high         := tf_high
        last_valid_low          := tf_low
        last_bullish_valid_bar  := bar_index
        last_bullish_valid_time := tf_time
        last_bullish_valid_high := tf_high
        last_bullish_valid_low  := tf_low
    if is_bearish_valid
        last_valid_high         := tf_high
        last_valid_low          := tf_low
        last_bearish_valid_bar  := bar_index
        last_bearish_valid_time := tf_time
        last_bearish_valid_high := tf_high
        last_bearish_valid_low  := tf_low

// ============================================================================
// 11. TRADE MANAGEMENT
// ============================================================================
if array.size(patterns) > 0
    for i = array.size(patterns) - 1 to 0
        p = array.get(patterns, i)
        is_bullish = str.contains(p.pattern_type, "BULL")
        if bar_index > p.confirmation_bar
            if p.state == "UNACTIVE"
                bool touches = is_bullish ? (tf_low <= p.entry_price) : (tf_high >= p.entry_price)
                if touches
                    p.state    := "ACTIVE"
                    p.fill_bar := bar_index
            if p.state == "ACTIVE"
                bool tp_hit = is_bullish ? (tf_high >= p.tp_price) : (tf_low <= p.tp_price)
                if tp_hit
                    p.state := "INACTIVE"
                    if na(p.end_time)
                        p.end_time := tf_time
        array.set(patterns, i, p)

// ============================================================================
// 12. VISUALIZATION — IMPULSE BOXES
// ============================================================================
if input_show_impulse_boxes and barstate.islast and array.size(impulse_history) > 0
    for i = 0 to array.size(impulse_history) - 1
        imp = array.get(impulse_history, i)
        bool show_this = IS_BULL ? imp.impulse_type == "LI" : imp.impulse_type == "UI"
        if show_this
            if imp.impulse_type == "UI"
                box.new(imp.start_time, imp.highest_high, imp.end_time, imp.lowest_low, color.new(#26a69a, 80), 1, line.style_dashed, xloc=xloc.bar_time, bgcolor=color.new(#26a69a, 96))
            else
                box.new(imp.start_time, imp.highest_high, imp.end_time, imp.lowest_low, color.new(#ef5350, 80), 1, line.style_dashed, xloc=xloc.bar_time, bgcolor=color.new(#ef5350, 96))

// ============================================================================
// 13. VISUALIZATION — PATTERN BOXES
// ============================================================================
if input_show_patterns and barstate.islast and array.size(patterns) > 0

    // PASS 1: ACTIVE
    for i = 0 to array.size(patterns) - 1
        p = array.get(patterns, i)
        if p.state != "ACTIVE"
            continue
        is_bullish = str.contains(p.pattern_type, "BULL")
        if IS_BULL != is_bullish
            continue
        if not na(p.entry_bar) and not na(p.confirmation_bar) and p.confirmation_bar >= p.entry_bar and not na(p.entry_price) and not na(p.tp_price)
            float box_h      = p.box_high
            float box_l      = p.box_low
            color box_border = is_bullish ? color.new(color.blue, 0)   : color.new(color.orange, 0)
            color box_bg     = is_bullish ? color.new(color.green, 85) : color.new(color.red, 85)
            box.new(p.entry_time, box_h, time, box_l, box_border, 3, line.style_solid, xloc=xloc.bar_time, bgcolor=box_bg)

            float  delta_pct  = ((p.tp_price / p.entry_price) - 1) * 100
            string label_text = "[" + tf_actual + "] ✓ " + (is_bullish ? "Bullish" : "Bearish") + " OF [Active]\n📋 " + get_rule_label(p.pattern_type) + "\nEntry: " + str.tostring(p.entry_price, "#.#####") + "\nTP: " + str.tostring(p.tp_price, "#.#####") + "\nΔ: " + str.tostring(delta_pct, "#.##") + "%"
            float box_height  = box_h - box_l
            float lbl_y       = is_bullish ? (box_h + box_height * 0.8) : (box_l - box_height * 0.8)
            label.new(time, lbl_y, text=label_text, style=is_bullish ? label.style_label_down : label.style_label_up, color=box_border, textcolor=color.white, size=size.small, xloc=xloc.bar_time)
            line.new(time, is_bullish ? box_h : box_l, time, lbl_y, color=color.new(color.gray, 60), width=1, style=line.style_dotted, xloc=xloc.bar_time)

            color entry_col = is_bullish ? color.new(#00e676, 0) : color.new(#ff1744, 0)
            color tp_col    = is_bullish ? color.new(#00e676, 40) : color.new(#ff1744, 40)
            line.new(p.entry_time, p.entry_price, time, p.entry_price, color=entry_col, width=4, style=line.style_solid, xloc=xloc.bar_time, extend=extend.none)
            line.new(p.entry_time, p.tp_price,    time, p.tp_price,    color=tp_col,   width=2, style=line.style_dashed, xloc=xloc.bar_time, extend=extend.none)

    // PASS 2: UNACTIVE & INACTIVE
    for i = 0 to array.size(patterns) - 1
        p = array.get(patterns, i)
        bool show_inactive = p.state == "INACTIVE" ? input_show_inactive_patterns : true
        if p.state == "INVALIDATED" or p.state == "ACTIVE" or not show_inactive
            continue
        is_bullish = str.contains(p.pattern_type, "BULL")
        if IS_BULL != is_bullish
            continue
        if not na(p.entry_bar) and not na(p.confirmation_bar) and p.confirmation_bar >= p.entry_bar
            float  box_h      = p.box_high
            float  box_l      = p.box_low
            bool   is_unact   = p.state == "UNACTIVE"
            string state_text = is_unact ? "Unactive" : "Completed - TP Hit"
            color  box_border = is_unact ? (is_bullish ? color.new(color.green, 0) : color.new(color.red, 0)) : color.new(color.gray, 50)
            color  box_bg     = is_unact ? (is_bullish ? color.new(color.green, 85) : color.new(color.red, 85)) : color.new(color.gray, 90)
            color  lbl_col    = is_unact ? (is_bullish ? color.new(color.green, 0) : color.new(color.red, 0)) : color.new(color.gray, 0)
            color  line_col   = is_unact ? (is_bullish ? color.new(color.green, 0) : color.new(color.red, 0)) : color.new(color.gray, 0)
            color  tp_col     = is_unact ? (is_bullish ? color.new(color.green, 30) : color.new(color.red, 30)) : color.new(color.gray, 50)

            int right_edge = is_unact ? time : (not na(p.end_time) ? p.end_time : time)
            box.new(p.entry_time, box_h, right_edge, box_l, box_border, 3, line.style_solid, xloc=xloc.bar_time, bgcolor=box_bg)

            float  delta_pct  = ((p.tp_price / p.entry_price) - 1) * 100
            string label_text = "[" + tf_actual + "] ✓ " + (is_bullish ? "Bullish" : "Bearish") + " OF [" + state_text + "]\n📋 " + get_rule_label(p.pattern_type) + "\nEntry: " + str.tostring(p.entry_price, "#.#####") + "\nTP: " + str.tostring(p.tp_price, "#.#####") + "\nΔ: " + str.tostring(delta_pct, "#.##") + "%"
            float box_height  = box_h - box_l
            float lbl_y       = is_bullish ? (box_h + box_height * 0.8) : (box_l - box_height * 0.8)
            label.new(right_edge, lbl_y, text=label_text, style=is_bullish ? label.style_label_down : label.style_label_up, color=lbl_col, textcolor=color.white, size=size.small, xloc=xloc.bar_time)
            line.new(right_edge, is_bullish ? box_h : box_l, right_edge, lbl_y, color=color.new(color.gray, 60), width=1, style=line.style_dotted, xloc=xloc.bar_time)
            line.new(p.entry_time, p.entry_price, right_edge, p.entry_price, color=line_col, width=2, style=line.style_solid, xloc=xloc.bar_time, extend=extend.none)
            line.new(p.entry_time, p.tp_price,    right_edge, p.tp_price,    color=tp_col,   width=1, style=line.style_dashed, xloc=xloc.bar_time, extend=extend.none)

// ============================================================================
// 14. LIVE PATTERN MARKERS
// ============================================================================
if array.size(patterns) > 0
    for i = 0 to array.size(patterns) - 1
        p = array.get(patterns, i)
        if p.state == "ACTIVE" and barstate.islast
            is_bullish = str.contains(p.pattern_type, "BULL")
            if IS_BULL != is_bullish
                continue
            color  marker_col = is_bullish ? color.new(#00e676, 0) : color.new(#ff1744, 0)
            string lbl_text   = is_bullish ? "▲ ACTIVE LONG\nEntry: " + str.tostring(p.entry_price, "#.####") : "▼ ACTIVE SHORT\nEntry: " + str.tostring(p.entry_price, "#.####")
            label.new(time, p.entry_price, text=lbl_text, style=label.style_label_left, color=marker_col, textcolor=color.white, size=size.normal, xloc=xloc.bar_time)
            color tp_col = is_bullish ? color.new(#00e676, 60) : color.new(#ff1744, 60)
            int   tp_off = timeframe.in_seconds() * 1000 * 10
            label.new(time + tp_off, p.tp_price, text="TP: " + str.tostring(p.tp_price, "#.####"), style=label.style_label_left, color=tp_col, textcolor=color.white, size=size.small, xloc=xloc.bar_time)

// ============================================================================
// 15. STATISTICS TABLE
// ============================================================================
int cnt_unmitigated = 0
int cnt_open        = 0
int cnt_completed   = 0

if array.size(patterns) > 0
    for i = 0 to array.size(patterns) - 1
        p = array.get(patterns, i)
        is_bullish = str.contains(p.pattern_type, "BULL")
        if IS_BULL != is_bullish
            continue
        switch p.state
            "UNACTIVE" => cnt_unmitigated += 1
            "ACTIVE"   => cnt_open        += 1
            "INACTIVE" => cnt_completed   += 1

var table stats_tbl = table.new(get_table_pos(input_table_pos), 2, 6, border_width=1)

if barstate.islast and input_show_table
    string imp_disp = in_upper_impulse ? "▲ UI" : in_lower_impulse ? "▼ LI" : "─"
    color  imp_col  = in_upper_impulse ? color.new(#26a69a, 70) : in_lower_impulse ? color.new(#ef5350, 70) : color.new(#546e7a, 70)
    string dir_lbl  = IS_BULL ? "▲ Bullish" : "▼ Bearish"
    string opn_lbl  = IS_BULL ? "Open ▲"   : "Open ▼"
    color  opn_col  = IS_BULL ? color.new(#66bb6a, 10) : color.new(#ef5350, 10)

    table.cell(stats_tbl, 0, 0, "Impulse",     bgcolor=color.new(#37474f, 30), text_color=color.new(color.white, 10), text_size=size.small)
    table.cell(stats_tbl, 1, 0, imp_disp,      bgcolor=imp_col, text_color=color.white, text_size=size.normal)
    table.cell(stats_tbl, 0, 1, "Timeframe",   bgcolor=color.new(#37474f, 85), text_color=color.new(color.white, 30), text_size=size.tiny)
    table.cell(stats_tbl, 1, 1, tf_actual + " · " + dir_lbl, bgcolor=color.new(input_color, 60), text_color=color.white, text_size=size.small)
    table.cell(stats_tbl, 0, 2, "Unmitigated", bgcolor=color.new(#37474f, 85), text_color=color.new(color.white, 30), text_size=size.tiny)
    table.cell(stats_tbl, 1, 2, str.tostring(cnt_unmitigated), bgcolor=color.new(#455a64, 85), text_color=color.new(#42a5f5, 10), text_size=size.small)
    table.cell(stats_tbl, 0, 3, opn_lbl,       bgcolor=color.new(#37474f, 85), text_color=color.new(color.white, 30), text_size=size.tiny)
    table.cell(stats_tbl, 1, 3, str.tostring(cnt_open), bgcolor=color.new(#455a64, 85), text_color=opn_col, text_size=size.small)
    table.cell(stats_tbl, 0, 4, "Completed",   bgcolor=color.new(#37474f, 85), text_color=color.new(color.white, 30), text_size=size.tiny)
    table.cell(stats_tbl, 1, 4, str.tostring(cnt_completed), bgcolor=color.new(#455a64, 85), text_color=color.new(#42a5f5, 10), text_size=size.small)
    table.cell(stats_tbl, 0, 5, "Valid H/L",   bgcolor=color.new(#37474f, 85), text_color=color.new(color.white, 30), text_size=size.tiny)
    table.cell(stats_tbl, 1, 5, str.tostring(last_valid_high, format.mintick) + "\n" + str.tostring(last_valid_low, format.mintick), bgcolor=color.new(#455a64, 85), text_color=color.new(color.white, 10), text_size=size.tiny)
